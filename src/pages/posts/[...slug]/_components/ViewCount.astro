---
import { useTranslations } from "@/i18n";
import {
  PUBLIC_SUPABASE_URL,
  PUBLIC_SUPABASE_ANON_KEY,
} from "astro:env/client";

type Props = {
  slug: string;
};

const { slug } = Astro.props;

const t = useTranslations();
---

<span
  data-view-slug={slug}
  data-template-vi={t.post.viewCount}
  class="text-muted-foreground text-sm"
></span>

<script
  data-astro-rerun
  define:vars={{
    supabaseUrl: PUBLIC_SUPABASE_URL,
    supabaseKey: PUBLIC_SUPABASE_ANON_KEY,
  }}
>
  async function initViewCount() {
    const el = document.querySelector("[data-view-slug]");
    if (!el || !supabaseUrl || !supabaseKey) return;

    const slug = el.dataset.viewSlug;
    const sessionKey = `view-counted:${slug}`;
    const headers = {
      apikey: supabaseKey,
      Authorization: `Bearer ${supabaseKey}`,
      "Content-Type": "application/json",
    };

    let count;

    if (sessionStorage.getItem(sessionKey)) {
      // Session đã đếm — chỉ đọc, không increment thêm
      const res = await fetch(
        `${supabaseUrl}/rest/v1/post_views?slug=eq.${encodeURIComponent(slug)}&select=view_count`,
        { headers }
      );
      if (!res.ok) return;
      const rows = await res.json();
      count = rows[0]?.view_count ?? 0;
    } else {
      // Session mới — gọi RPC để increment atomic
      const res = await fetch(`${supabaseUrl}/rest/v1/rpc/increment_view`, {
        method: "POST",
        headers,
        body: JSON.stringify({ p_slug: slug }),
      });
      if (!res.ok) return;
      count = await res.json();
      sessionStorage.setItem(sessionKey, "1");
    }

    const lang = document.documentElement.getAttribute("data-lang") || "vi";
    const templates = {
      vi: el.dataset.templateVi ?? "· {{count}} lượt xem",
      en: "· {{count}} views",
    };
    const template = templates[lang] || templates.vi;
    el.textContent = template.replace(
      "{{count}}",
      Number(count).toLocaleString(lang === "en" ? "en-US" : "vi-VN")
    );
  }

  function updateViewCountDisplay() {
    const el = document.querySelector("[data-view-slug]");
    if (!el) return;
    const lang = document.documentElement.getAttribute("data-lang") || "vi";
    const templates = {
      vi: el.dataset.templateVi ?? "· {{count}} lượt xem",
      en: "· {{count}} views",
    };
    const template = templates[lang] || templates.vi;
    const match = el.textContent?.match(/(\d+)/);
    if (match) {
      const count = Number(match[1]);
      el.textContent = template.replace(
        "{{count}}",
        count.toLocaleString(lang === "en" ? "en-US" : "vi-VN")
      );
    }
  }

  initViewCount();

  document.addEventListener("astro:page-load", initViewCount);
  // Watch for lang change via i18n-client.ts
  const observer = new MutationObserver(() => {
    if (document.documentElement.getAttribute("data-lang")) updateViewCountDisplay();
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-lang"] });
</script>
