---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import EbookCard from "@/components/EbookCard.astro";
import { getSortedEbooks } from "@/utils/getSortedEbooks";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const ebooks = await getCollection("ebooks");
const sortedEbooks = getSortedEbooks(ebooks, locale);
---

<Layout title={`${t.pages.ebooksTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.ebooksTitle} pageDesc={t.pages.ebooksDesc}>
    {
      sortedEbooks.length > 0 ? (
        <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4">
          {sortedEbooks.map(ebook => (
            <EbookCard {...ebook} />
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground italic">
          {t.ebooks.comingSoon}
        </p>
      )
    }
  </Main>

  <Footer />
</Layout>
