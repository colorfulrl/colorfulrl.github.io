---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import FloatingDecor from "@/components/decor/FloatingDecor.astro";
import config from "@/config";

const support = await getEntry("pages", "support");

if (!support) {
  throw new Error(
    "Missing content entry: `support.md` or `support.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(support);
---

<Layout
  title={`${support.data.title} | ${config.site.title}`}
  description={support.data.description}
  ogImage={support.data.ogImage}
  canonicalURL={support.data.canonicalURL}
>
  <FloatingDecor />
  <Header />

  <Breadcrumb />

  <Main pageTitle={support.data.title} class="app-prose qr-page relative z-10">
    <Content />
  </Main>

  <Footer />
</Layout>
