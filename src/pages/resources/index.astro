---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ResourceCard from "@/components/ResourceCard.astro";
import IconArticle from "@/assets/icons/IconArticle.svg";
import IconVideo from "@/assets/icons/IconVideo.svg";
import IconRepo from "@/assets/icons/IconRepo.svg";
import IconCourse from "@/assets/icons/IconCourse.svg";
import IconTool from "@/assets/icons/IconTool.svg";
import IconPlatform from "@/assets/icons/IconPlatform.svg";
import IconPaper from "@/assets/icons/IconPaper.svg";
import { RESOURCE_TYPES, RESOURCE_TYPE_ORDER } from "@/data/resourceTypes";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations();
const tEn = useTranslations("en");

const allResources = await getCollection("resources");
const resources = allResources
  .filter(r => !r.data.draft)
  .sort((a, b) => {
    const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
    const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
    if (orderA !== orderB) return orderA - orderB;
    const dateA = a.data.date?.getTime() ?? 0;
    const dateB = b.data.date?.getTime() ?? 0;
    return dateB - dateA;
  });

// Collect types: known order first, then any extra types found in data
const knownOrder = [...RESOURCE_TYPE_ORDER];
const extraTypes = [...new Set(resources.map(r => r.data.type))].filter(
  t => !knownOrder.includes(t as (typeof RESOURCE_TYPE_ORDER)[number])
);
const typeOrder = [...knownOrder, ...extraTypes];

// Group by type, keep only types that have at least one resource
const grouped = new Map<string, typeof resources>();
for (const type of typeOrder) grouped.set(type, []);
for (const r of resources) {
  if (!grouped.has(r.data.type)) grouped.set(r.data.type, []);
  grouped.get(r.data.type)!.push(r);
}
const activeTypes = typeOrder.filter(type => (grouped.get(type)?.length ?? 0) > 0);

const TYPE_ICONS: Record<string, any> = {
  article: IconArticle,
  video: IconVideo,
  repo: IconRepo,
  course: IconCourse,
  tool: IconTool,
  platform: IconPlatform,
  paper: IconPaper,
};

function getTypeLabel(type: string) {
  const meta = RESOURCE_TYPES[type];
  if (!meta) return type;
  return meta.vi;
}

function getTypeLabelEn(type: string) {
  return RESOURCE_TYPES[type]?.en ?? type;
}
---

<Layout title={`${t.pages.resourcesTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.resourcesTitle} pageDesc={t.pages.resourcesDesc} i18nTitle="pages.resourcesTitle" i18nDesc="pages.resourcesDesc">
    {
      resources.length === 0 ? (
        <p class="text-muted-foreground italic" data-i18n="ebooks.comingSoon">{t.ebooks.comingSoon}</p>
      ) : (
        <>
          <!-- Search bar -->
          <div
            id="res-search-wrap"
            class="mb-8"
            data-show-more-vi={t.ebooks.readMore}
            data-show-more-en={tEn.ebooks.readMore}
            data-show-less-vi={t.ebooks.readLess}
            data-show-less-en={tEn.ebooks.readLess}
            data-count-label-vi="kết quả"
            data-count-label-en="results"
            data-no-results-vi="Không tìm thấy kết quả nào."
            data-no-results-en="No results found."
          >
            <div class="relative flex items-center">
              <svg class="text-muted-foreground pointer-events-none absolute left-3.5 size-4 shrink-0"
                xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
              </svg>
              <input
                id="res-search"
                type="text"
                placeholder="Tìm kiếm tài nguyên..."
                data-en-placeholder="Search resources..."
                autocomplete="off"
                class="border-border bg-surface/50 focus:border-accent w-full rounded-lg border py-2.5 pl-10 pr-24 text-sm outline-none transition-colors focus:ring-1 focus:ring-accent/20"
              />
              <span id="res-search-count"
                class="text-muted-foreground pointer-events-none absolute right-10 hidden text-xs tabular-nums">
              </span>
              <button id="res-search-clear"
                class="text-muted-foreground hover:text-foreground absolute right-3 hidden rounded p-1 transition-colors"
                aria-label="Xóa tìm kiếm"
                data-en-aria-label="Clear search"
                style="display:none">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                  class="size-4">
                  <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
              </button>
            </div>
          </div>

          <nav aria-label={t.pages.resourcesTitle} class="mb-10">
            <ul class="flex flex-wrap gap-2">
              {activeTypes.map(type => {
                const Icon = TYPE_ICONS[type];
                const meta = RESOURCE_TYPES[type];
                return (
                  <li>
                    <a
                      href={`#${type}`}
                      class:list={[
                        "flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium transition-opacity hover:opacity-80",
                        meta?.iconBg ?? "bg-zinc-100 dark:bg-zinc-800",
                        meta?.iconColor ?? "text-zinc-600 dark:text-zinc-300",
                      ]}
                    >
                      {Icon && <Icon class="size-4" />}
                      <span data-en={getTypeLabelEn(type) !== getTypeLabel(type) ? getTypeLabelEn(type) : undefined}>{getTypeLabel(type)}</span>
                      <span class="text-xs opacity-60">({grouped.get(type)!.length})</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>

          {activeTypes.map(type => {
            const Icon = TYPE_ICONS[type];
            const meta = RESOURCE_TYPES[type];
            return (
              <section id={type} class="mb-12 scroll-mt-20" data-resource-section>
                <div class="mb-4 flex items-center gap-2">
                  {Icon && (
                    <span
                      class:list={[
                        "flex size-8 items-center justify-center rounded-lg",
                        meta?.iconBg ?? "bg-zinc-100 dark:bg-zinc-800",
                        meta?.iconColor ?? "text-zinc-600 dark:text-zinc-300",
                      ]}
                    >
                      <Icon class="size-5" />
                    </span>
                  )}
                  <h2 class="font-display text-xl font-semibold tracking-tight">
                    <span data-en={getTypeLabelEn(type) !== getTypeLabel(type) ? getTypeLabelEn(type) : undefined}>{getTypeLabel(type)}</span>
                  </h2>
                </div>
                <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {grouped.get(type)!.map(resource => (
                    <ResourceCard {...resource} />
                  ))}
                </ul>
              </section>
            );
          })}
        </>
      )
    }
  </Main>

  <Footer />
</Layout>

<script>
  const INITIAL_SHOW = 6;

  interface SectionState {
    el: HTMLElement;
    items: HTMLElement[];
    btn: HTMLButtonElement | null;
    expanded: boolean;
  }

  function getWrapLabel(wrap: HTMLElement, key: string) {
    const lang = document.documentElement.getAttribute("data-lang") || "vi";
    const d = wrap.dataset as Record<string, string | undefined>;
    return (lang === "en" ? d[key + "En"] : d[key + "Vi"]) ?? d[key] ?? "";
  }

  function initResources() {
    // Clean up any buttons injected by a previous init (SPA navigation)
    document.querySelectorAll(".res-show-more").forEach(el => el.remove());

    const wrap = document.getElementById("res-search-wrap");
    if (!wrap) return;

    // Build per-section state
    const sections: SectionState[] = [];
    document.querySelectorAll<HTMLElement>("[data-resource-section]").forEach(section => {
      const ul = section.querySelector("ul");
      if (!ul) return;
      const items = [...ul.querySelectorAll<HTMLElement>(":scope > li")];

      let btn: HTMLButtonElement | null = null;
      if (items.length > INITIAL_SHOW) {
        items.slice(INITIAL_SHOW).forEach(li => (li.style.display = "none"));

        btn = document.createElement("button");
        btn.className =
          "res-show-more mt-5 flex items-center gap-1.5 text-sm text-accent decoration-dashed underline-offset-4 hover:underline";
        btn.dataset.total = String(items.length);
        updateBtnText(btn, items.length, false,
          getWrapLabel(wrap, "showMore"), getWrapLabel(wrap, "showLess"));
        ul.after(btn);
      }

      const state: SectionState = { el: section, items, btn, expanded: false };
      sections.push(state);

      btn?.addEventListener("click", () => {
        state.expanded = !state.expanded;
        items.forEach((li, i) => {
          if (i >= INITIAL_SHOW) li.style.display = state.expanded ? "" : "none";
        });
        btn!.dataset.expanded = state.expanded ? "1" : "";
        updateBtnText(btn!, items.length, state.expanded,
          getWrapLabel(wrap, "showMore"), getWrapLabel(wrap, "showLess"));
      });
    });

    // Search
    const input  = document.getElementById("res-search") as HTMLInputElement | null;
    const clearBtn = document.getElementById("res-search-clear") as HTMLButtonElement | null;
    const countEl  = document.getElementById("res-search-count");

    function applySearch(query: string) {
      const q = query.toLowerCase();
      let total = 0;
      const countLabel  = getWrapLabel(wrap!, "countLabel");
      const noResults   = getWrapLabel(wrap!, "noResults");

      sections.forEach(({ el, items, btn, expanded }) => {
        if (!q) {
          items.forEach((li, i) => {
            li.style.display = i >= INITIAL_SHOW && !expanded ? "none" : "";
          });
          el.style.display = "";
          if (btn) btn.style.display = "";
        } else {
          if (btn) btn.style.display = "none";
          let sectionCount = 0;
          items.forEach(li => {
            const match = (li.dataset.search ?? "").includes(q);
            li.style.display = match ? "" : "none";
            if (match) sectionCount++;
          });
          el.style.display = sectionCount === 0 ? "none" : "";
          total += sectionCount;
        }
      });

      if (clearBtn) clearBtn.style.display = q ? "" : "none";
      if (countEl) {
        if (q) {
          countEl.textContent = total === 0 ? noResults : `${total} ${countLabel}`;
          countEl.classList.remove("hidden");
          countEl.className =
            total === 0
              ? "text-red-500 pointer-events-none absolute right-10 text-xs tabular-nums"
              : "text-muted-foreground pointer-events-none absolute right-10 text-xs tabular-nums";
        } else {
          countEl.classList.add("hidden");
        }
      }
    }

    input?.addEventListener("input", e =>
      applySearch((e.target as HTMLInputElement).value.trim())
    );
    input?.addEventListener("keydown", e => {
      if (e.key === "Escape") {
        (e.target as HTMLInputElement).value = "";
        applySearch("");
        (e.target as HTMLInputElement).blur();
      }
    });
    clearBtn?.addEventListener("click", () => {
      if (input) { input.value = ""; applySearch(""); input.focus(); }
    });

    // Re-render show-more button labels on lang change
    const langObs = new MutationObserver(() => {
      document.querySelectorAll<HTMLButtonElement>(".res-show-more").forEach(btn => {
        const total = parseInt(btn.dataset.total ?? "0", 10);
        const expanded = btn.dataset.expanded === "1";
        updateBtnText(btn, total, expanded,
          getWrapLabel(wrap!, "showMore"), getWrapLabel(wrap!, "showLess"));
      });
    });
    langObs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-lang"] });
  }

  function updateBtnText(
    btn: HTMLButtonElement,
    total: number,
    expanded: boolean,
    showMore: string,
    showLess: string,
  ) {
    const remaining = total - INITIAL_SHOW;
    if (expanded) {
      btn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="size-3.5 opacity-70"><path d="m18 15-6-6-6 6"/></svg>
        <span>${showLess}</span>`;
    } else {
      btn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="size-3.5 opacity-70"><path d="m6 9 6 6 6-6"/></svg>
        <span>${showMore} (${remaining})</span>`;
    }
  }

  document.addEventListener("astro:page-load", initResources);
  if (document.readyState !== "loading") initResources();
</script>
