---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ResourceCard from "@/components/ResourceCard.astro";
import IconArticle from "@/assets/icons/IconArticle.svg";
import IconVideo from "@/assets/icons/IconVideo.svg";
import IconRepo from "@/assets/icons/IconRepo.svg";
import IconCourse from "@/assets/icons/IconCourse.svg";
import IconTool from "@/assets/icons/IconTool.svg";
import IconPlatform from "@/assets/icons/IconPlatform.svg";
import { RESOURCE_TYPES, RESOURCE_TYPE_ORDER } from "@/data/resourceTypes";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const allResources = await getCollection("resources");
const resources = allResources
  .filter(r => !r.data.draft)
  .sort((a, b) => {
    const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
    const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
    if (orderA !== orderB) return orderA - orderB;
    const dateA = a.data.date?.getTime() ?? 0;
    const dateB = b.data.date?.getTime() ?? 0;
    return dateB - dateA;
  });

// Collect types: known order first, then any extra types found in data
const knownOrder = [...RESOURCE_TYPE_ORDER];
const extraTypes = [...new Set(resources.map(r => r.data.type))].filter(
  t => !knownOrder.includes(t as (typeof RESOURCE_TYPE_ORDER)[number])
);
const typeOrder = [...knownOrder, ...extraTypes];

// Group by type, keep only types that have at least one resource
const grouped = new Map<string, typeof resources>();
for (const type of typeOrder) grouped.set(type, []);
for (const r of resources) {
  if (!grouped.has(r.data.type)) grouped.set(r.data.type, []);
  grouped.get(r.data.type)!.push(r);
}
const activeTypes = typeOrder.filter(type => (grouped.get(type)?.length ?? 0) > 0);

const TYPE_ICONS: Record<string, any> = {
  article: IconArticle,
  video: IconVideo,
  repo: IconRepo,
  course: IconCourse,
  tool: IconTool,
  platform: IconPlatform,
};

function getTypeLabel(type: string) {
  const meta = RESOURCE_TYPES[type];
  if (!meta) return type;
  return locale === "en" ? meta.en : meta.vi;
}
---

<Layout title={`${t.pages.resourcesTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.resourcesTitle} pageDesc={t.pages.resourcesDesc}>
    {
      resources.length === 0 ? (
        <p class="text-muted-foreground italic">Coming soon…</p>
      ) : (
        <>
          <nav aria-label={t.pages.resourcesTitle} class="mb-10">
            <ul class="flex flex-wrap gap-2">
              {activeTypes.map(type => {
                const Icon = TYPE_ICONS[type];
                const meta = RESOURCE_TYPES[type];
                return (
                  <li>
                    <a
                      href={`#${type}`}
                      class:list={[
                        "flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-medium transition-opacity hover:opacity-80",
                        meta?.iconBg ?? "bg-zinc-100 dark:bg-zinc-800",
                        meta?.iconColor ?? "text-zinc-600 dark:text-zinc-300",
                      ]}
                    >
                      {Icon && <Icon class="size-4" />}
                      {getTypeLabel(type)}
                      <span class="text-xs opacity-60">({grouped.get(type)!.length})</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>

          {activeTypes.map(type => {
            const Icon = TYPE_ICONS[type];
            const meta = RESOURCE_TYPES[type];
            return (
              <section id={type} class="mb-12 scroll-mt-20">
                <div class="mb-4 flex items-center gap-2">
                  {Icon && (
                    <span
                      class:list={[
                        "flex size-8 items-center justify-center rounded-lg",
                        meta?.iconBg ?? "bg-zinc-100 dark:bg-zinc-800",
                        meta?.iconColor ?? "text-zinc-600 dark:text-zinc-300",
                      ]}
                    >
                      <Icon class="size-5" />
                    </span>
                  )}
                  <h2 class="font-display text-xl font-semibold tracking-tight">
                    {getTypeLabel(type)}
                  </h2>
                </div>
                <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {grouped.get(type)!.map(resource => (
                    <ResourceCard {...resource} />
                  ))}
                </ul>
              </section>
            );
          })}
        </>
      )
    }
  </Main>

  <Footer />
</Layout>
