---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import { buildResearchGraph } from "@/utils/buildResearchGraph";
import { useTranslations } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { Content as ResearchIntro } from "./_intro.md";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const entries = await getCollection("research");
const { nodes, edges } = buildResearchGraph(entries);

const curricula = (await getCollection("curriculum", e => !e.data.draft))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const graphData = {
  nodes: nodes.map(n => ({
    data: {
      id: n.id,
      label: n.label,
      type: n.type,
      description: n.description,
      slug: n.slug ?? null,
      href: n.slug
        ? getRelativeLocaleUrl(locale, `research/${n.slug}`)
        : null,
    },
  })),
  edges: edges.map((e, i) => ({
    data: { id: `e${i}`, source: e.source, target: e.target, label: e.label },
  })),
};

const graphJson = JSON.stringify(graphData);
---

<Layout title={`${t.nav.research} | ${config.site.title}`}>
  <Header />

  <main id="main-content">

  <!-- ── Graph section (full viewport height) ────────────────────────── -->
  <div class="app-layout flex flex-col" style="height: calc(100svh - 4rem);">

    <!-- Toolbar -->
    <div class="border-border bg-background/80 relative z-20 border-b py-2 backdrop-blur-sm">
      <div class="flex flex-col gap-y-1.5">

        <!-- Row 1: Type filter buttons — scrollable, never wraps -->
        <div class="flex items-center gap-0.5 overflow-x-auto" style="scrollbar-width:none">
          <span class="text-foreground mr-2 shrink-0 text-sm font-medium">{t.nav.research}</span>
          <button data-type-btn="topic"
            class="flex shrink-0 items-center gap-1.5 rounded-full px-2 py-1 text-xs transition-all hover:bg-surface">
            <span class="bg-red-500 size-2.5 rounded-full"></span>
            <span class="text-muted-foreground">Topic</span>
          </button>
          <button data-type-btn="approach"
            class="flex shrink-0 items-center gap-1.5 rounded-full px-2 py-1 text-xs transition-all hover:bg-surface">
            <span class="bg-orange-500 size-2.5 rounded-full"></span>
            <span class="text-muted-foreground">Approach</span>
          </button>
          <button data-type-btn="concept"
            class="flex shrink-0 items-center gap-1.5 rounded-full px-2 py-1 text-xs transition-all hover:bg-surface">
            <span class="bg-amber-400 size-2.5 rounded-full"></span>
            <span class="text-muted-foreground">Concept</span>
          </button>
          <button data-type-btn="architecture"
            class="flex shrink-0 items-center gap-1.5 rounded-full px-2 py-1 text-xs transition-all hover:bg-surface">
            <span class="bg-emerald-500 size-2.5 rounded-full"></span>
            <span class="text-muted-foreground">Arch</span>
          </button>
          <button data-type-btn="algorithm"
            class="flex shrink-0 items-center gap-1.5 rounded-full px-2 py-1 text-xs transition-all hover:bg-surface">
            <span class="bg-cyan-500 size-2.5 rounded-full"></span>
            <span class="text-muted-foreground">Algo</span>
          </button>
          <button data-type-btn="paper"
            class="flex shrink-0 items-center gap-1.5 rounded-full px-2 py-1 text-xs transition-all hover:bg-surface">
            <span class="bg-indigo-500 size-2.5 rounded-full"></span>
            <span class="text-muted-foreground">Paper</span>
          </button>
          <button data-type-btn="benchmark"
            class="flex shrink-0 items-center gap-1.5 rounded-full px-2 py-1 text-xs transition-all hover:bg-surface">
            <span class="bg-violet-500 size-2.5 rounded-full"></span>
            <span class="text-muted-foreground">Bench</span>
          </button>
        </div>

        <!-- Row 2: Search + Zoom — always single row -->
        <div class="flex items-center gap-2">

          <!-- Search with dropdown (relative wrapper for dropdown positioning) -->
          <div class="relative min-w-0 flex-1">
            <div class="flex items-center">
              <svg class="text-muted-foreground pointer-events-none absolute left-2.5 size-3.5"
                xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
              </svg>
              <input
                id="cy-search"
                type="text"
                placeholder="Tìm node, khái niệm, paper..."
                autocomplete="off"
                class="border-border bg-surface/50 focus:border-accent w-full rounded-md border py-1 pl-8 pr-16 text-xs outline-none transition-colors focus:ring-1 focus:ring-accent/20"
              />
              <span id="cy-search-count"
                class="pointer-events-none absolute right-7 hidden text-xs tabular-nums">
              </span>
              <button id="cy-search-clear"
                class="text-muted-foreground hover:text-foreground absolute right-1.5 hidden rounded p-0.5 transition-colors"
                aria-label="Xóa tìm kiếm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                  class="size-3.5">
                  <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
              </button>
            </div>

            <!-- Dropdown results (B) -->
            <div id="cy-search-dropdown"
              class="border-border bg-background absolute left-0 right-0 top-full z-50 mt-1 hidden max-h-72 overflow-y-auto rounded-lg border shadow-xl">
            </div>
          </div>

          <!-- Zoom controls -->
          <div class="flex shrink-0 items-center gap-1">
            <button id="cy-zoom-in" class="border-border hover:bg-surface rounded border px-2 py-0.5 text-sm" aria-label="Zoom in">+</button>
            <button id="cy-zoom-out" class="border-border hover:bg-surface rounded border px-2 py-0.5 text-sm" aria-label="Zoom out">−</button>
            <button id="cy-reset" class="border-border hover:bg-surface rounded border px-2 py-0.5 text-sm">Reset</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Graph canvas + panels -->
    <div
      id="cy-graph-wrap"
      class="relative flex-1 flex overflow-hidden"
      data-connects-to="Kết nối tới"
      data-connected-from="Được kết nối bởi"
      data-no-rels="Không có quan hệ"
      data-no-desc="Không có mô tả"
      data-open-page="Mở trang →"
      data-no-results="Không có kết quả"
    >
      <div id="cy" class="flex-1 w-full" data-graph={graphJson}></div>

      <!-- Relationship panel (D) — slides in from right -->
      <aside
        id="cy-rel-panel"
        class="border-border bg-background/97 absolute right-0 top-0 bottom-0 z-10 w-64 translate-x-full overflow-y-auto border-l shadow-xl backdrop-blur-sm transition-transform duration-200"
        aria-label="Quan hệ node"
      >
        <!-- Panel header -->
        <div class="border-border flex items-start justify-between border-b px-3 py-2.5">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span id="cy-panel-badge" class="shrink-0 rounded px-1.5 py-0.5 text-xs font-medium"></span>
              <h3 id="cy-panel-title" class="font-display min-w-0 truncate text-sm font-semibold leading-snug"></h3>
            </div>
            <p id="cy-panel-desc" class="text-muted-foreground mt-1 line-clamp-2 text-xs leading-relaxed"></p>
          </div>
          <button id="cy-panel-close"
            class="text-muted-foreground hover:text-foreground ml-2 mt-0.5 shrink-0 rounded p-0.5 transition-colors"
            aria-label="Đóng">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="size-4"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <!-- Panel body (JS-populated) -->
        <div id="cy-panel-body" class="p-3 text-sm"></div>
      </aside>

      <!-- Focus mode indicator pill (simplified) -->
      <div id="cy-focus-bar"
        class="pointer-events-none absolute inset-x-0 bottom-4 z-10 flex justify-center"
        style="display:none">
        <div class="bg-background/90 border-border pointer-events-auto inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs shadow-lg backdrop-blur-sm">
          <span class="bg-accent size-2 animate-pulse rounded-full"></span>
          <span class="text-muted-foreground">Focus:</span>
          <span id="cy-focus-label" class="text-foreground max-w-[8rem] truncate font-medium"></span>
          <span class="text-border mx-0.5">·</span>
          <span class="text-muted-foreground">Lân cận</span>
          <button data-depth="1" class="text-accent rounded px-1 font-semibold transition-colors hover:text-accent">1</button>
          <button data-depth="2" class="text-muted-foreground rounded px-1 transition-colors hover:text-accent">2</button>
          <span class="text-border mx-0.5">·</span>
          <button id="cy-exit-focus"
            class="text-muted-foreground hover:text-accent font-medium transition-colors">
            Esc
          </button>
        </div>
      </div>
    </div>

    <!-- Tooltip (fixed so it escapes any positioned ancestor) -->
    <div id="cy-tooltip"
      class="border-border bg-background pointer-events-none fixed z-30 hidden max-w-64 rounded-lg border p-3 shadow-lg">
      <div class="flex items-start gap-2">
        <span id="cy-tooltip-badge" class="mt-0.5 shrink-0 rounded px-1.5 py-0.5 text-xs font-medium"></span>
        <p id="cy-tooltip-title" class="font-display font-semibold leading-snug"></p>
      </div>
      <p id="cy-tooltip-desc" class="text-muted-foreground mt-1.5 text-xs leading-relaxed"></p>
      <p id="cy-tooltip-hint" class="text-accent mt-2 hidden text-xs">Nhấn để xem chi tiết →</p>
    </div>
  </div>
  <!-- ── /Graph section ─────────────────────────────────────────────── -->

  <!-- ── Curriculum section ───────────────────────────────────────────── -->
  {curricula.length > 0 && (
    <section class="border-border border-t">
      <div class="app-layout py-10">
        <h2 class="font-display text-2xl font-semibold tracking-tight">
          {locale === "en" ? "Learning Paths" : "Lộ trình học"}
        </h2>
        <p class="text-muted-foreground mt-2 max-w-2xl text-sm">
          {locale === "en"
            ? "Domain-specific reading paths: prerequisites → core → advanced."
            : "Lộ trình đọc theo từng domain: nền tảng → cốt lõi → nâng cao."}
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {curricula.map(d => {
            const paperCount = d.data.stages.reduce((n, s) => n + s.items.length, 0);
            return (
              <a href={getRelativeLocaleUrl(locale, `research/${d.id}`)}
                class="border-border hover:border-accent group rounded-xl border p-5 transition-colors">
                <h3 class="font-display group-hover:text-accent text-base font-semibold transition-colors">{d.data.domain}</h3>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed line-clamp-3">
                  {locale === "en" ? (d.data.descriptionEn ?? d.data.description) : d.data.description}
                </p>
                <div class="text-muted-foreground mt-3 flex items-center gap-3 text-xs">
                  <span>{d.data.stages.length} {locale === "en" ? "stages" : "giai đoạn"}</span>
                  <span>·</span>
                  <span>{paperCount} {locale === "en" ? "papers" : "paper"}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ── Research notes ────────────────────────────────────────────────── -->
  <div class="border-border border-t">
    <div class="app-layout py-14">
      <article class="app-prose max-w-3xl prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)">
        <ResearchIntro />
      </article>
    </div>
  </div>

  </main>

  <Footer />
</Layout>

<script>
  import cytoscape from "cytoscape";
  import fcose from "cytoscape-fcose";
  import Fuse from "fuse.js";
  import type { FuseResult } from "fuse.js";

  // Register fcose once at module level (O(n log n) vs cose's O(n²))
  cytoscape.use(fcose as unknown as cytoscape.Ext);

  function initGraph() {
    const container = document.getElementById("cy") as (HTMLElement & { _cy?: unknown }) | null;
    if (!container || container._cy) return;

    const raw = container.dataset.graph;
    if (!raw) return;
    // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment
    const { nodes, edges } = JSON.parse(raw);

    // Hide canvas until layout settles, then fade in — avoids the initial
    // random-position flash and per-frame layout jank.
    container.style.opacity = "0";
    container.style.transition = "opacity 450ms ease";

    const css = getComputedStyle(document.documentElement);
    const accent     = css.getPropertyValue("--color-accent").trim()            || "#6366f1";
    const foreground = css.getPropertyValue("--color-foreground").trim()        || "#1a1a1a";
    const border     = css.getPropertyValue("--color-border").trim()            || "#e5e7eb";
    const surface    = css.getPropertyValue("--color-surface").trim()           || "#ffffff";
    const muted      = css.getPropertyValue("--color-muted-foreground").trim()  || "#6b7280";
    const background = css.getPropertyValue("--color-background").trim()        || "#ffffffb6";

    const cy = cytoscape({
      container,
      elements: { nodes, edges },
      style: [
        // ── Rainbow node types (R O Y G C I V) ─────────────────────────
        {
          selector: 'node[type="topic"]',
          style: { "background-color": "#ef4444", label: "data(label)", color: "#fff", "text-valign": "center", "text-halign": "center", "font-size": "11px", "font-weight": "bold", width: 72, height: 72, "text-wrap": "wrap", "text-max-width": "60px" },
        },
        {
          selector: 'node[type="approach"]',
          style: { "background-color": "#f97316", label: "data(label)", color: "#fff", "text-valign": "center", "text-halign": "center", "font-size": "10px", "font-weight": 600, width: 60, height: 60, "text-wrap": "wrap", "text-max-width": "52px" },
        },
        {
          selector: 'node[type="concept"]',
          style: { "background-color": "#f59e0b", label: "data(label)", color: "#451a03", "text-valign": "center", "text-halign": "center", "font-size": "10px", "font-weight": 600, width: 54, height: 54, "text-wrap": "wrap", "text-max-width": "46px" },
        },
        {
          selector: 'node[type="architecture"]',
          style: { "background-color": "#10b981", label: "data(label)", color: "#fff", "text-valign": "center", "text-halign": "center", "font-size": "10px", "font-weight": 600, width: 50, height: 50, "text-wrap": "wrap", "text-max-width": "42px" },
        },
        {
          selector: 'node[type="algorithm"]',
          style: { "background-color": "#06b6d4", label: "data(label)", color: "#fff", "text-valign": "center", "text-halign": "center", "font-size": "9px", "font-weight": 600, width: 44, height: 44, "text-wrap": "wrap", "text-max-width": "38px" },
        },
        {
          selector: 'node[type="paper"]',
          style: { "background-color": surface, "border-color": border, "border-width": 2, label: "data(label)", color: foreground, "text-valign": "center", "text-halign": "center", "font-size": "9px", width: 44, height: 44, "text-wrap": "wrap", "text-max-width": "38px" },
        },
        {
          selector: 'node[type="benchmark"]',
          style: { "background-color": "#8b5cf6", label: "data(label)", color: "#fff", "text-valign": "center", "text-halign": "center", "font-size": "9px", "font-weight": 600, width: 40, height: 40, "text-wrap": "wrap", "text-max-width": "34px" },
        },
        { selector: 'node[type="paper"][?slug]', style: { "border-color": "#6366f1", "border-width": 2 } },
        { selector: "node:selected", style: { "border-color": accent, "border-width": 3, "overlay-color": accent, "overlay-opacity": 0.1, "overlay-padding": 4 } },
        {
          selector: "edge",
          style: { width: 1.5, "line-color": border, "target-arrow-color": border, "target-arrow-shape": "triangle", "curve-style": "bezier", label: "data(label)", "font-size": "8px", color: muted, "text-background-color": background, "text-background-opacity": 0.8, "text-background-padding": "2px" },
        },
        { selector: ".dimmed", style: { opacity: 0.12 } },
        { selector: ".drop-highlighted", style: { "border-color": accent, "border-width": 3 } },
      ],
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      layout: {
        name: "fcose",
        quality: "default",       // "proof" = higher quality, slower
        animate: false,           // place instantly; we fade #cy in to avoid jank
        fit: true,
        padding: 48,
        nodeDimensionsIncludeLabels: true,
        uniformNodeDimensions: false,
        packComponents: true,
        nodeRepulsion: 7000,
        idealEdgeLength: 120,
        edgeElasticity: 0.45,
        numIter: 1000,
        tile: true,
        randomize: true,
      } as any,
      minZoom: 0.3, maxZoom: 3, wheelSensitivity: 0.3,
      textureOnViewport: true,    // cached texture during pan/zoom = smoother
    });

    container._cy = cy;

    // Fade-in is triggered by applyInitialVisibility() once the backbone layout
    // settles (called at the end of init). Fallback in case it never fires.
    window.setTimeout(() => { container.style.opacity = "1"; }, 1500);

    // ── Locale strings from data attributes ───────────────────────────────────
    const wrap = document.getElementById("cy-graph-wrap");
    const L = {
      connectsTo:    wrap?.dataset.connectsTo    ?? "Kết nối tới",
      connectedFrom: wrap?.dataset.connectedFrom ?? "Được kết nối bởi",
      noRels:        wrap?.dataset.noRels        ?? "Không có quan hệ",
      noDesc:        wrap?.dataset.noDesc        ?? "Không có mô tả",
      openPage:      wrap?.dataset.openPage      ?? "Mở trang →",
      noResults:     wrap?.dataset.noResults     ?? "Không có kết quả",
    };

    // ── State ─────────────────────────────────────────────────────────────────
    const BACKBONE_TYPES = ["topic", "approach", "concept", "architecture", "algorithm"];
    // Papers + benchmarks hidden by default — they're the bulk of the clutter.
    // Revealed on demand (toggle, or when isolating a node's neighborhood).
    const visibleTypes = new Set(BACKBONE_TYPES);
    let focusedNodeId: string | null = null;
    let focusDepth = 1;                 // neighborhood hops shown when isolating
    const homePositions: Record<string, { x: number; y: number }> = {};
    let searchMatches: ReturnType<typeof cy.nodes> | null = null;
    let dropdownHighlight = -1;

    // ── Fuse.js index (A + C) ─────────────────────────────────────────────────
    interface NodeDoc {
      id: string;
      label: string;
      type: string;
      description: string;
      edgeContext: string;
    }

    function buildFuseIndex() {
      const docs: NodeDoc[] = (cy.nodes().map(node => ({
        id:          node.id(),
        label:       (node.data("label") as string) ?? "",
        type:        (node.data("type")  as string) ?? "",
        description: (node.data("description") as string) ?? "",
        edgeContext: node.connectedEdges()
          .map(e => e.data("label") as string)
          .filter(Boolean)
          .join(" "),
      })) as unknown as NodeDoc[]);

      return new Fuse<NodeDoc>(docs, {
        keys: [
          { name: "label",       weight: 3 },
          { name: "description", weight: 2 },
          { name: "edgeContext", weight: 1 },
        ],
        threshold: 0.38,
        includeScore: true,
        minMatchCharLength: 1,
      });
    }

    let fuse = buildFuseIndex();

    // ── Visual state engine ───────────────────────────────────────────────────
    // Dimming is now only used for search highlighting; focus = isolation (hide).
    function applyDimming() {
      cy.elements(":visible").removeClass("dimmed");
      if (searchMatches) {
        cy.nodes(":visible").addClass("dimmed");
        cy.edges(":visible").addClass("dimmed");
        searchMatches.removeClass("dimmed");
        searchMatches.connectedEdges(":visible").removeClass("dimmed");
      }
    }

    function refreshEdges() {
      cy.edges().each(edge => {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        if (!edge.source().hidden() && !edge.target().hidden()) (edge as any).show();
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        else (edge as any).hide();
      });
    }

    // Run fcose on a subset of elements (used for backbone, isolation, toggles).
    function runFcose(
      eles: ReturnType<typeof cy.elements>,
      opts: { randomize?: boolean; animate?: boolean; duration?: number; onStop?: () => void },
    ) {
      if (eles.length === 0) { opts.onStop?.(); return; }
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const lay = (eles as any).layout({
        name: "fcose",
        quality: "default",
        animate: opts.animate ?? true,
        animationDuration: opts.duration ?? 450,
        fit: true,
        padding: 48,
        nodeDimensionsIncludeLabels: true,
        packComponents: true,
        nodeRepulsion: 7000,
        idealEdgeLength: 120,
        edgeElasticity: 0.45,
        numIter: 1000,
        tile: true,
        randomize: opts.randomize ?? false,
      });
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      if (opts.onStop) (lay as any).one("layoutstop", opts.onStop);
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      (lay as any).run();
    }

    function snapshotHome() {
      cy.nodes().forEach(n => { homePositions[n.id()] = { ...n.position() }; });
    }
    function restoreHome() {
      cy.batch(() => {
        cy.nodes().forEach(n => {
          const h = homePositions[n.id()];
          if (h) n.position(h);
        });
      });
    }

    // Show/hide nodes according to the current visibleTypes set.
    function applyVisibility() {
      cy.batch(() => {
        cy.nodes().forEach(n => {
          const t = n.data("type") as string;
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          if (visibleTypes.has(t)) (n as any).show(); else (n as any).hide();
        });
      });
      refreshEdges();
    }

    function updateTypeButtons() {
      document.querySelectorAll<HTMLElement>("[data-type-btn]").forEach(btn => {
        const t = btn.getAttribute("data-type-btn")!;
        btn.classList.toggle("opacity-40", !visibleTypes.has(t));
      });
    }

    // Initial decluttered view: backbone only, laid out, then fade in.
    function applyInitialVisibility() {
      applyVisibility();
      updateTypeButtons();
      runFcose(cy.elements(":visible"), {
        randomize: true,
        animate: false,
        onStop: () => { snapshotHome(); container!.style.opacity = "1"; },
      });
    }

    // ── Type filter ───────────────────────────────────────────────────────────
    function toggleType(type: string) {
      // Leave isolation cleanly (back to home positions) before re-filtering.
      if (focusedNodeId) {
        focusedNodeId = null;
        if (focusBar) focusBar.style.display = "none";
        hideRelPanel();
        restoreHome();
      }

      if (visibleTypes.has(type)) visibleTypes.delete(type);
      else visibleTypes.add(type);

      applyVisibility();
      fuse = buildFuseIndex();
      updateTypeButtons();
      runFcose(cy.elements(":visible"), {
        randomize: false, animate: true, duration: 400, onStop: snapshotHome,
      });

      const searchInput = document.getElementById("cy-search") as HTMLInputElement | null;
      if (searchInput?.value) handleSearch(searchInput.value.trim());
    }

    // ── Dropdown (B) ──────────────────────────────────────────────────────────
    const dropdown = document.getElementById("cy-search-dropdown")!;

    const TYPE_BADGE: Record<string, string> = {
      topic:        "bg-red-100    text-red-700    dark:bg-red-900/30    dark:text-red-400",
      approach:     "bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400",
      concept:      "bg-amber-100  text-amber-700  dark:bg-amber-900/30  dark:text-amber-400",
      architecture: "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
      algorithm:    "bg-cyan-100   text-cyan-700   dark:bg-cyan-900/30   dark:text-cyan-400",
      paper:        "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400",
      benchmark:    "bg-violet-100 text-violet-700 dark:bg-violet-900/30 dark:text-violet-400",
    };

    function showDropdown(results: FuseResult<NodeDoc>[]) {
      if (!dropdown) return;
      if (results.length === 0) {
        dropdown.innerHTML = `<p class="px-4 py-3 text-xs text-muted-foreground">${L.noResults}</p>`;
        dropdown.classList.remove("hidden");
        return;
      }

      dropdown.innerHTML = results.slice(0, 8).map((r, i) => {
        const { id, label, type, description } = r.item;
        const badge = TYPE_BADGE[type] ?? "bg-zinc-100 text-zinc-600";
        const desc = description
          ? `<p class="mt-0.5 truncate text-xs text-muted-foreground">${description.slice(0, 72)}${description.length > 72 ? "…" : ""}</p>`
          : "";
        return `<button
          class="dd-item w-full px-3 py-2 text-left transition-colors hover:bg-surface flex items-start gap-2.5"
          data-node-id="${id}"
          data-dd-index="${i}"
        >
          <span class="mt-0.5 shrink-0 rounded px-1.5 py-0.5 text-xs font-medium ${badge}">${type}</span>
          <div class="min-w-0">
            <p class="truncate text-xs font-medium leading-snug">${label}</p>
            ${desc}
          </div>
        </button>`;
      }).join("");

      dropdown.classList.remove("hidden");
      dropdownHighlight = -1;
      highlightDropdownItem(-1);

      dropdown.querySelectorAll<HTMLButtonElement>(".dd-item").forEach(btn => {
        btn.addEventListener("click", () => {
          const nodeId = btn.dataset.nodeId!;
          selectDropdownNode(nodeId);
        });
      });
    }

    function closeDropdown() {
      dropdown?.classList.add("hidden");
      dropdownHighlight = -1;
    }

    function highlightDropdownItem(idx: number) {
      dropdown?.querySelectorAll<HTMLElement>(".dd-item").forEach((btn, i) => {
        btn.classList.toggle("bg-surface", i === idx);
      });
    }

    function navigateDropdown(dir: number) {
      const items = dropdown?.querySelectorAll(".dd-item");
      if (!items || items.length === 0) return;
      dropdownHighlight = Math.max(-1, Math.min(items.length - 1, dropdownHighlight + dir));
      highlightDropdownItem(dropdownHighlight);
      // Pan to preview without entering focus
      if (dropdownHighlight >= 0) {
        const btn = items[dropdownHighlight] as HTMLButtonElement;
        const node = cy.getElementById(btn.dataset.nodeId!);
        if (!node.empty()) panTo(node);
      }
    }

    function selectDropdownNode(nodeId: string) {
      closeDropdown();
      const searchInput = document.getElementById("cy-search") as HTMLInputElement | null;
      if (searchInput) searchInput.value = "";
      searchMatches = null;
      updateSearchUI();
      const node = cy.getElementById(nodeId);
      if (!node.empty()) {
        enterFocus(node);
        panTo(node);
      }
    }

    // Close dropdown when clicking outside
    document.addEventListener("click", e => {
      const target = e.target as Node;
      const searchWrap = document.getElementById("cy-search")?.closest(".relative");
      if (searchWrap && !searchWrap.contains(target)) closeDropdown();
    });

    // ── Search (A + C) ────────────────────────────────────────────────────────
    function handleSearch(query: string) {
      if (!query) {
        searchMatches = null;
        closeDropdown();
        applyDimming();
        updateSearchUI();
        return;
      }
      if (focusedNodeId) exitFocus(false);

      const results = fuse.search(query);
      const matchedIds = new Set(results.slice(0, 30).map(r => r.item.id));

      searchMatches = cy.nodes(":visible").filter(n => matchedIds.has(n.id()));
      applyDimming();
      updateSearchUI();
      showDropdown(results);
    }

    function panTo(node: cytoscape.NodeSingular) {
      cy.animate({ center: { eles: node }, zoom: Math.max(cy.zoom(), 1.4) }, { duration: 350 });
    }

    function updateSearchUI() {
      const countEl = document.getElementById("cy-search-count");
      const clearEl = document.getElementById("cy-search-clear");
      if (!countEl || !clearEl) return;

      if (!searchMatches) {
        countEl.classList.add("hidden");
        clearEl.classList.add("hidden");
        return;
      }

      clearEl.classList.remove("hidden");
      countEl.classList.remove("hidden");

      if (searchMatches.length === 0) {
        countEl.textContent = "0";
        countEl.className = "pointer-events-none absolute right-7 text-xs tabular-nums text-muted-foreground";
      } else {
        countEl.textContent = String(searchMatches.length);
        countEl.className = "pointer-events-none absolute right-7 text-xs tabular-nums text-accent font-medium";
      }
    }

    // ── Relationship panel (D) ────────────────────────────────────────────────
    const relPanel    = document.getElementById("cy-rel-panel")!;
    const panelTitle  = document.getElementById("cy-panel-title")!;
    const panelBadge  = document.getElementById("cy-panel-badge")!;
    const panelDesc   = document.getElementById("cy-panel-desc")!;
    const panelBody   = document.getElementById("cy-panel-body")!;

    function showRelPanel(node: cytoscape.NodeSingular) {
      const { label, type, description, href } = node.data() as {
        label: string; type: string; description?: string; href?: string;
      };

      panelTitle.textContent = label;
      panelBadge.textContent = type;
      panelBadge.className = `shrink-0 rounded px-1.5 py-0.5 text-xs font-medium ${TYPE_BADGE[type] ?? "bg-zinc-100 text-zinc-600"}`;
      panelDesc.textContent = description || L.noDesc;

      // Build relationships grouped by direction
      interface RelItem { edgeLabel: string; nodeLabel: string; nodeId: string }
      const outgoing: RelItem[] = [];
      const incoming: RelItem[] = [];

      node.connectedEdges().each(edge => {
        if (edge.source().id() === node.id()) {
          outgoing.push({
            edgeLabel: (edge.data("label") as string) || "→",
            nodeLabel: edge.target().data("label") as string,
            nodeId:    edge.target().id(),
          });
        } else {
          incoming.push({
            edgeLabel: (edge.data("label") as string) || "←",
            nodeLabel: edge.source().data("label") as string,
            nodeId:    edge.source().id(),
          });
        }
      });

      let html = "";

      if (outgoing.length === 0 && incoming.length === 0) {
        html = `<p class="text-muted-foreground text-xs italic">${L.noRels}</p>`;
      } else {
        if (outgoing.length > 0) {
          html += `<p class="text-muted-foreground mb-2 text-xs font-semibold uppercase tracking-wider">${L.connectsTo}</p>`;
          html += outgoing.map(r => relItem(r.nodeId, r.nodeLabel, r.edgeLabel, "→")).join("");
        }
        if (incoming.length > 0) {
          if (outgoing.length > 0) html += `<div class="my-3 border-t border-border"></div>`;
          html += `<p class="text-muted-foreground mb-2 text-xs font-semibold uppercase tracking-wider">${L.connectedFrom}</p>`;
          html += incoming.map(r => relItem(r.nodeId, r.nodeLabel, r.edgeLabel, "←")).join("");
        }
      }

      if (href) {
        html += `<div class="mt-4 border-t border-border pt-3">
          <a href="${href}"
            class="text-accent flex items-center gap-1 text-xs hover:underline">
            ${L.openPage}
          </a>
        </div>`;
      }

      panelBody.innerHTML = html;

      // Wire up related node buttons
      panelBody.querySelectorAll<HTMLButtonElement>(".rel-node-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const nid = btn.dataset.nodeId!;
          const targetNode = cy.getElementById(nid);
          if (!targetNode.empty()) {
            enterFocus(targetNode);
            panTo(targetNode);
          }
        });
      });

      relPanel.classList.remove("translate-x-full");
    }

    function relItem(nodeId: string, nodeLabel: string, edgeLabel: string, arrow: string) {
      const typeOfNode = cy.getElementById(nodeId).data("type") as string;
      const badge = TYPE_BADGE[typeOfNode] ?? "bg-zinc-100 text-zinc-600";
      return `<button class="rel-node-btn mb-1.5 flex w-full items-start gap-2 rounded-md px-2 py-1.5 text-left transition-colors hover:bg-surface"
          data-node-id="${nodeId}">
          <span class="shrink-0 rounded px-1.5 py-0.5 text-xs font-medium ${badge}">${arrow}</span>
          <div class="min-w-0">
            <p class="truncate text-xs font-medium leading-snug">${nodeLabel}</p>
            <p class="text-muted-foreground mt-0.5 text-xs italic">${edgeLabel}</p>
          </div>
        </button>`;
    }

    function hideRelPanel() {
      relPanel.classList.add("translate-x-full");
    }

    // ── Focus mode = neighborhood isolation ─────────────────────────────────────
    const focusBar   = document.getElementById("cy-focus-bar") as HTMLElement | null;
    const focusLabel = document.getElementById("cy-focus-label");

    // Hide everything except the focused node's k-hop neighborhood, then
    // re-layout just that subgraph so it spreads out and is readable.
    function isolateNeighborhood(node: cytoscape.NodeSingular) {
      let nodeSet = node.closedNeighborhood().nodes();
      for (let i = 1; i < focusDepth; i++) {
        nodeSet = nodeSet.union(nodeSet.closedNeighborhood().nodes());
      }
      const ids = new Set(nodeSet.map(n => n.id()));
      const subEdges = nodeSet.connectedEdges()
        .filter(e => ids.has(e.source().id()) && ids.has(e.target().id()));
      const sub = nodeSet.union(subEdges);

      cy.batch(() => {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (cy.elements() as any).hide();
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (sub as any).show();
      });
      cy.elements(":visible").removeClass("dimmed");
      runFcose(cy.elements(":visible"), { randomize: true, animate: true, duration: 450 });
    }

    function enterFocus(node: cytoscape.NodeSingular) {
      searchMatches = null;
      const si = document.getElementById("cy-search") as HTMLInputElement | null;
      if (si) si.value = "";
      closeDropdown();
      updateSearchUI();

      // Snapshot the current "home" layout the first time we enter isolation,
      // so exiting can restore the backbone exactly.
      if (!focusedNodeId) snapshotHome();

      focusedNodeId = node.id();
      isolateNeighborhood(node);

      if (focusLabel) focusLabel.textContent = node.data("label");
      if (focusBar) focusBar.style.display = "flex";
      updateDepthButtons();
      showRelPanel(node);
    }

    function exitFocus(andApply = true) {
      const wasIsolated = focusedNodeId !== null;
      focusedNodeId = null;
      if (focusBar) focusBar.style.display = "none";
      hideRelPanel();

      if (wasIsolated) {
        restoreHome();
        applyVisibility();
        cy.elements(":visible").removeClass("dimmed");
        cy.animate(
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          { fit: { eles: cy.elements(":visible"), padding: 48 } } as any,
          { duration: 400 },
        );
      } else if (andApply) {
        applyDimming();
      }
    }

    function updateDepthButtons() {
      document.querySelectorAll<HTMLElement>("[data-depth]").forEach(btn => {
        const d = Number(btn.getAttribute("data-depth"));
        btn.classList.toggle("text-accent", d === focusDepth);
        btn.classList.toggle("font-semibold", d === focusDepth);
        btn.classList.toggle("text-muted-foreground", d !== focusDepth);
      });
    }

    // ── Tooltip ───────────────────────────────────────────────────────────────
    const tooltip = document.getElementById("cy-tooltip")!;
    const ttTitle  = document.getElementById("cy-tooltip-title")!;
    const ttDesc   = document.getElementById("cy-tooltip-desc")!;
    const ttBadge  = document.getElementById("cy-tooltip-badge")!;
    const ttHint   = document.getElementById("cy-tooltip-hint")!;

    const TYPE_LABEL: Record<string, string> = {
      topic: "Topic", approach: "Approach", concept: "Concept",
      architecture: "Architecture", algorithm: "Algorithm",
      paper: "Paper", benchmark: "Benchmark",
    };

    cy.on("mouseover", "node", evt => {
      const node = evt.target;
      const { label, description, type, slug } = node.data();
      const pos  = node.renderedPosition();
      const rect = container.getBoundingClientRect();

      container.style.cursor = "pointer";
      ttTitle.textContent = label;
      ttDesc.textContent  = description ?? "";
      ttBadge.textContent = TYPE_LABEL[type] ?? type;
      ttBadge.className   = `rounded px-1.5 py-0.5 text-xs font-medium ${TYPE_BADGE[type] ?? ""}`;
      ttHint.classList.toggle("hidden", !slug);

      tooltip.classList.remove("hidden");
      let x = rect.left + pos.x + 16;
      let y = rect.top  + pos.y - 8;
      tooltip.style.left = `${x}px`;
      tooltip.style.top  = `${y}px`;
      const tr = tooltip.getBoundingClientRect();
      if (tr.right  > window.innerWidth  - 8) tooltip.style.left = `${x - tr.width  - 32}px`;
      if (tr.bottom > window.innerHeight - 8) tooltip.style.top  = `${y - tr.height     }px`;

      cy.elements(":visible").addClass("dimmed");
      node.removeClass("dimmed");
      node.neighborhood(":visible").removeClass("dimmed");
    });

    cy.on("mouseout", "node", () => {
      container.style.cursor = "default";
      tooltip.classList.add("hidden");
      applyDimming();
    });

    // ── Node click ────────────────────────────────────────────────────────────
    cy.on("tap", "node", evt => {
      const node = evt.target;
      const href = node.data("href") as string | null;

      if (focusedNodeId === node.id()) {
        if (href) window.location.href = href;
        else exitFocus();
      } else {
        enterFocus(node);
      }
    });

    cy.on("tap", evt => { if (evt.target === cy) exitFocus(); });

    // ── Toolbar wiring ────────────────────────────────────────────────────────
    document.querySelectorAll<HTMLElement>("[data-type-btn]").forEach(btn => {
      btn.addEventListener("click", () => {
        const type = btn.getAttribute("data-type-btn");
        if (type) toggleType(type);
      });
    });

    // Neighborhood depth (1 / 2 hop) — live-updates if currently isolating.
    document.querySelectorAll<HTMLElement>("[data-depth]").forEach(btn => {
      btn.addEventListener("click", () => {
        focusDepth = Number(btn.getAttribute("data-depth")) || 1;
        updateDepthButtons();
        if (focusedNodeId) {
          const n = cy.getElementById(focusedNodeId);
          if (!n.empty()) isolateNeighborhood(n);
        }
      });
    });

    const searchInput = document.getElementById("cy-search") as HTMLInputElement | null;
    searchInput?.addEventListener("input", e =>
      handleSearch((e.target as HTMLInputElement).value.trim())
    );
    searchInput?.addEventListener("keydown", e => {
      const ddVisible = !dropdown?.classList.contains("hidden");
      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (ddVisible) navigateDropdown(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (ddVisible) navigateDropdown(-1);
      } else if (e.key === "Enter") {
        if (ddVisible && dropdownHighlight >= 0) {
          const items = dropdown?.querySelectorAll<HTMLButtonElement>(".dd-item");
          if (items?.[dropdownHighlight]) {
            selectDropdownNode(items[dropdownHighlight].dataset.nodeId!);
          }
        } else if (ddVisible) {
          const first = dropdown?.querySelector<HTMLButtonElement>(".dd-item");
          if (first) selectDropdownNode(first.dataset.nodeId!);
        }
      } else if (e.key === "Escape") {
        (e.target as HTMLInputElement).value = "";
        handleSearch("");
        (e.target as HTMLInputElement).blur();
      }
    });

    document.getElementById("cy-search-clear")?.addEventListener("click", () => {
      if (searchInput) { searchInput.value = ""; handleSearch(""); searchInput.focus(); }
    });

    document.getElementById("cy-exit-focus")?.addEventListener("click", () => exitFocus());
    document.getElementById("cy-panel-close")?.addEventListener("click", () => exitFocus());

    document.addEventListener("keydown", e => {
      if (e.key === "Escape" && focusedNodeId && document.activeElement?.id !== "cy-search")
        exitFocus();
    });

    document.getElementById("cy-zoom-in")?.addEventListener("click", () => {
      cy.zoom({ level: cy.zoom() * 1.2, renderedPosition: { x: container.clientWidth / 2, y: container.clientHeight / 2 } });
    });
    document.getElementById("cy-zoom-out")?.addEventListener("click", () => {
      cy.zoom({ level: cy.zoom() / 1.2, renderedPosition: { x: container.clientWidth / 2, y: container.clientHeight / 2 } });
    });
    document.getElementById("cy-reset")?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      searchMatches = null;
      updateSearchUI();
      closeDropdown();
      focusedNodeId = null;
      if (focusBar) focusBar.style.display = "none";
      hideRelPanel();
      visibleTypes.clear();
      BACKBONE_TYPES.forEach(t => visibleTypes.add(t));
      applyInitialVisibility();
    });

    // ── Initial render: backbone only, laid out, then fade in ───────────────────
    applyInitialVisibility();

    // Deep-link from Curriculum Map: /research?focus=<id> opens that node isolated.
    const focusParam = new URLSearchParams(window.location.search).get("focus");
    if (focusParam) {
      window.setTimeout(() => {
        const n = cy.getElementById(focusParam);
        if (!n.empty()) enterFocus(n);
      }, 500);
    }
  }

  document.addEventListener("astro:page-load", initGraph);
  if (document.readyState !== "loading") initGraph();
</script>
