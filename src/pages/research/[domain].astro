---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

export async function getStaticPaths() {
  const domains = await getCollection("curriculum", e => !e.data.draft);
  const research = await getCollection("research");
  return domains.map(entry => ({
    params: { domain: entry.id },
    props: { entry, research },
  }));
}

const { entry, research } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const { Content } = await render(entry);

const researchMap = new Map(research.map(r => [r.id, r]));
const inGraphIds = new Set(
  research.filter(r => !r.data.draft && !r.data.graphExclude).map(r => r.id),
);

const STAGE_COLORS = ["#10b981", "#f59e0b", "#8b5cf6", "#06b6d4", "#ef4444"];
const COL = 260;
const ROW = 120;

interface CurrNode {
  id: string; label: string; description: string; color: string;
  inGraph: boolean; detailHref: string | null; graphHref: string | null;
  stage: string; x: number; y: number;
}

const nodes: CurrNode[] = [];
const rawEdges: { source: string; target: string }[] = [];

entry.data.stages.forEach((stage, si) => {
  const n = stage.items.length;
  stage.items.forEach((item, ii) => {
    const r = researchMap.get(item.ref);
    const label = r?.data.graphLabel ?? r?.data.title ?? item.ref;
    const description = r?.data.graphDescription ?? r?.data.abstract ?? "";
    const inGraph = inGraphIds.has(item.ref);
    nodes.push({
      id: item.ref,
      label,
      description,
      color: STAGE_COLORS[si % STAGE_COLORS.length],
      inGraph,
      detailHref: r ? getRelativeLocaleUrl(locale, `research/${item.ref}`) : null,
      graphHref: inGraph
        ? `${getRelativeLocaleUrl(locale, "research")}?focus=${item.ref}`
        : null,
      stage: stage.id,
      x: si * COL,
      y: (ii - (n - 1) / 2) * ROW,
    });
    (item.after ?? []).forEach(a => rawEdges.push({ source: a, target: item.ref }));
  });
});

const nodeIds = new Set(nodes.map(n => n.id));
const edges = rawEdges.filter(e => nodeIds.has(e.source) && nodeIds.has(e.target));

const graphData = {
  nodes: nodes.map(n => ({
    data: {
      id: n.id, label: n.label, description: n.description, color: n.color,
      inGraph: n.inGraph, detailHref: n.detailHref, graphHref: n.graphHref, stage: n.stage,
    },
    position: { x: n.x, y: n.y },
  })),
  edges: edges.map((e, i) => ({ data: { id: `e${i}`, source: e.source, target: e.target } })),
};
const graphJson = JSON.stringify(graphData);

const stageLabels = entry.data.stages.map((s, i) => ({
  label: locale === "en" ? (s.labelEn ?? s.label) : s.label,
  color: STAGE_COLORS[i % STAGE_COLORS.length],
}));

const domainDesc =
  locale === "en" ? (entry.data.descriptionEn ?? entry.data.description) : entry.data.description;
---

<Layout title={`${entry.data.domain} | ${config.site.title}`}>
  <Header />

  <main id="main-content">
    <div class="app-layout flex flex-col" style="height: calc(100svh - 4rem);">

      <!-- Header / breadcrumb + stage legend -->
      <div class="border-border bg-background/80 relative z-20 border-b py-2 backdrop-blur-sm">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <a href={getRelativeLocaleUrl(locale, "research")}
            class="text-muted-foreground hover:text-accent shrink-0 text-sm">
            ← {locale === "en" ? "Research" : "Nghiên cứu"}
          </a>
          <span class="text-foreground shrink-0 text-sm font-semibold">{entry.data.domain}</span>

          <!-- Stage legend (reading order) -->
          <div class="flex items-center gap-1 overflow-x-auto" style="scrollbar-width:none">
            {stageLabels.map((s, i) => (
              <>
                {i > 0 && <span class="text-border shrink-0">→</span>}
                <span class="flex shrink-0 items-center gap-1.5 rounded-full px-2 py-1 text-xs">
                  <span class="size-2.5 rounded-full" style={`background-color:${s.color}`}></span>
                  <span class="text-muted-foreground">{s.label}</span>
                </span>
              </>
            ))}
          </div>

          <!-- Zoom controls -->
          <div class="ml-auto flex shrink-0 items-center gap-1">
            <button id="curr-zoom-in" class="border-border hover:bg-surface rounded border px-2 py-0.5 text-sm" aria-label="Zoom in">+</button>
            <button id="curr-zoom-out" class="border-border hover:bg-surface rounded border px-2 py-0.5 text-sm" aria-label="Zoom out">−</button>
            <button id="curr-reset" class="border-border hover:bg-surface rounded border px-2 py-0.5 text-sm">Reset</button>
          </div>
        </div>
      </div>

      <!-- Graph canvas + panel -->
      <div id="curr-wrap" class="relative flex flex-1 overflow-hidden">
        <div id="curr-cy" class="w-full flex-1" data-graph={graphJson}
          data-progress-key={`curriculum-read:${entry.id}`}
          data-l-detail={locale === "en" ? "Open details →" : "Mở chi tiết →"}
          data-l-graph={locale === "en" ? "View in main graph →" : "Xem trong graph chính →"}
          data-l-nodetail={locale === "en" ? "No detail page yet" : "Chưa có trang chi tiết"}></div>

        <!-- Detail panel -->
        <aside id="curr-panel"
          class="border-border bg-background/97 absolute right-0 top-0 bottom-0 z-10 w-64 translate-x-full overflow-y-auto border-l shadow-xl backdrop-blur-sm transition-transform duration-200">
          <div class="border-border flex items-start justify-between border-b px-3 py-2.5">
            <div class="min-w-0">
              <span id="curr-panel-stage" class="text-muted-foreground text-xs font-semibold uppercase tracking-wider"></span>
              <h3 id="curr-panel-title" class="font-display mt-0.5 text-sm font-semibold leading-snug"></h3>
            </div>
            <button id="curr-panel-close"
              class="text-muted-foreground hover:text-foreground ml-2 shrink-0 rounded p-0.5"
              aria-label="Đóng">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="size-4"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="p-3">
            <p id="curr-panel-desc" class="text-muted-foreground text-xs leading-relaxed"></p>

            <label class="mt-4 flex cursor-pointer items-center gap-2 text-sm">
              <input id="curr-panel-read" type="checkbox" class="accent-accent size-4" />
              <span>{locale === "en" ? "Mark as read" : "Đánh dấu đã đọc"}</span>
            </label>

            <div id="curr-panel-links" class="mt-4 space-y-2 border-t border-border pt-3"></div>
          </div>
        </aside>

        <!-- Focus pill -->
        <div id="curr-focus-bar"
          class="pointer-events-none absolute inset-x-0 bottom-4 z-10 flex justify-center"
          style="display:none">
          <div class="bg-background/90 border-border pointer-events-auto inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs shadow-lg backdrop-blur-sm">
            <span class="bg-accent size-2 animate-pulse rounded-full"></span>
            <span class="text-muted-foreground">{locale === "en" ? "Prereq path" : "Đường prereq"}</span>
            <span class="text-border mx-0.5">·</span>
            <button id="curr-exit-focus" class="text-muted-foreground hover:text-accent font-medium transition-colors">Esc</button>
          </div>
        </div>
      </div>

      <!-- Tooltip -->
      <div id="curr-tooltip"
        class="border-border bg-background pointer-events-none fixed z-30 hidden max-w-64 rounded-lg border p-3 shadow-lg">
        <p id="curr-tooltip-title" class="font-display font-semibold leading-snug"></p>
        <p id="curr-tooltip-desc" class="text-muted-foreground mt-1.5 text-xs leading-relaxed"></p>
      </div>
    </div>

    <!-- Domain intro prose -->
    <div class="app-layout border-t border-border py-14">
      <div class="mx-auto max-w-3xl">
        <h1 class="font-display text-accent text-3xl font-semibold tracking-tight">{entry.data.domain}</h1>
        <p class="text-muted-foreground mt-3">{domainDesc}</p>
        <article class="app-prose mt-6">
          <Content />
        </article>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import cytoscape from "cytoscape";

  function initCurriculum() {
    const container = document.getElementById("curr-cy") as (HTMLElement & { _cy?: unknown }) | null;
    if (!container || container._cy) return;
    const raw = container.dataset.graph;
    if (!raw) return;
    // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment
    const { nodes, edges } = JSON.parse(raw);
    const progressKey = container.dataset.progressKey ?? "curriculum-read";
    const L = {
      detail:   container.dataset.lDetail   ?? "Mở chi tiết →",
      graph:    container.dataset.lGraph    ?? "Xem trong graph chính →",
      noDetail: container.dataset.lNodetail ?? "Chưa có trang chi tiết",
    };

    const css = getComputedStyle(document.documentElement);
    const border     = css.getPropertyValue("--color-border").trim()           || "#e5e7eb";
    const muted      = css.getPropertyValue("--color-muted-foreground").trim()  || "#6b7280";
    const accent     = css.getPropertyValue("--color-accent").trim()            || "#6366f1";

    function loadRead(): Set<string> {
      try { return new Set(JSON.parse(localStorage.getItem(progressKey) ?? "[]")); }
      catch { return new Set(); }
    }
    function saveRead(s: Set<string>) {
      localStorage.setItem(progressKey, JSON.stringify([...s]));
    }
    const readSet = loadRead();

    const cy = cytoscape({
      container,
      elements: { nodes, edges },
      style: [
        {
          selector: "node",
          style: {
            shape: "round-rectangle",
            "background-color": "data(color)",
            label: "data(label)",
            color: "#fff",
            "text-valign": "center",
            "text-halign": "center",
            "font-size": "11px",
            "font-weight": 600,
            width: "label",
            height: 34,
            padding: "10px",
            "text-wrap": "wrap",
            "text-max-width": "130px",
            "border-width": 0,
          },
        },
        { selector: "node.read", style: { "border-width": 3, "border-color": "#22c55e" } },
        { selector: "node:selected", style: { "border-width": 3, "border-color": accent } },
        {
          selector: "edge",
          style: {
            width: 2,
            "line-color": border,
            "target-arrow-color": border,
            "target-arrow-shape": "triangle",
            "curve-style": "bezier",
          },
        },
        { selector: ".dimmed", style: { opacity: 0.15 } },
        { selector: "edge.path", style: { "line-color": accent, "target-arrow-color": accent, width: 2.5 } },
      ],
      layout: { name: "preset", fit: true, padding: 60 },
      minZoom: 0.3,
      maxZoom: 3,
      wheelSensitivity: 0.3,
      textureOnViewport: true,
    });
    container._cy = cy;

    readSet.forEach(id => {
      const n = cy.getElementById(id);
      if (!n.empty()) n.addClass("read");
    });

    let focusedId: string | null = null;

    const panel      = document.getElementById("curr-panel")!;
    const panelStage = document.getElementById("curr-panel-stage")!;
    const panelTitle = document.getElementById("curr-panel-title")!;
    const panelDesc  = document.getElementById("curr-panel-desc")!;
    const panelRead  = document.getElementById("curr-panel-read") as HTMLInputElement;
    const panelLinks = document.getElementById("curr-panel-links")!;
    const focusBar   = document.getElementById("curr-focus-bar") as HTMLElement | null;

    function highlightPath(node: cytoscape.NodeSingular) {
      const chain = node.predecessors().union(node);
      cy.elements().addClass("dimmed");
      chain.removeClass("dimmed");
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      (node.predecessors().edges() as any).addClass("path");
    }

    function clearHighlight() {
      cy.elements().removeClass("dimmed").removeClass("path");
    }

    function showPanel(node: cytoscape.NodeSingular) {
      const d = node.data();
      panelStage.textContent = d.stage as string;
      panelTitle.textContent = d.label as string;
      panelDesc.textContent  = (d.description as string) || "";
      panelRead.checked = node.hasClass("read");
      panelRead.onchange = () => {
        if (panelRead.checked) { node.addClass("read"); readSet.add(node.id()); }
        else { node.removeClass("read"); readSet.delete(node.id()); }
        saveRead(readSet);
      };

      let links = "";
      if (d.detailHref) {
        links += `<a href="${d.detailHref}" class="text-accent flex items-center gap-1 text-xs hover:underline">${L.detail}</a>`;
      }
      if (d.graphHref) {
        links += `<a href="${d.graphHref}" class="text-accent flex items-center gap-1 text-xs hover:underline">${L.graph}</a>`;
      }
      panelLinks.innerHTML = links || `<span class="text-muted-foreground text-xs italic">${L.noDetail}</span>`;

      panel.classList.remove("translate-x-full");
    }
    function hidePanel() { panel.classList.add("translate-x-full"); }

    function enterFocus(node: cytoscape.NodeSingular) {
      focusedId = node.id();
      highlightPath(node);
      if (focusBar) focusBar.style.display = "flex";
      showPanel(node);
      cy.animate({ center: { eles: node.predecessors().union(node) }, zoom: Math.min(cy.zoom(), 1.2) }, { duration: 300 });
    }
    function exitFocus() {
      focusedId = null;
      clearHighlight();
      if (focusBar) focusBar.style.display = "none";
      hidePanel();
    }

    const tooltip = document.getElementById("curr-tooltip")!;
    const ttTitle = document.getElementById("curr-tooltip-title")!;
    const ttDesc  = document.getElementById("curr-tooltip-desc")!;

    cy.on("mouseover", "node", evt => {
      const node = evt.target;
      container.style.cursor = "pointer";
      ttTitle.textContent = node.data("label");
      ttDesc.textContent  = node.data("description") ?? "";
      tooltip.classList.remove("hidden");
      const pos = node.renderedPosition();
      const rect = container.getBoundingClientRect();
      let x = rect.left + pos.x + 16, y = rect.top + pos.y - 8;
      tooltip.style.left = `${x}px`; tooltip.style.top = `${y}px`;
      const tr = tooltip.getBoundingClientRect();
      if (tr.right > window.innerWidth - 8) tooltip.style.left = `${x - tr.width - 32}px`;
      if (!focusedId) {
        cy.elements().addClass("dimmed");
        node.predecessors().union(node).removeClass("dimmed");
      }
    });
    cy.on("mouseout", "node", () => {
      container.style.cursor = "default";
      tooltip.classList.add("hidden");
      if (!focusedId) clearHighlight();
    });

    cy.on("tap", "node", evt => {
      const node = evt.target;
      if (focusedId === node.id()) exitFocus();
      else enterFocus(node);
    });
    cy.on("tap", evt => { if (evt.target === cy) exitFocus(); });

    document.getElementById("curr-panel-close")?.addEventListener("click", exitFocus);
    document.getElementById("curr-exit-focus")?.addEventListener("click", exitFocus);
    document.addEventListener("keydown", e => { if (e.key === "Escape" && focusedId) exitFocus(); });

    document.getElementById("curr-zoom-in")?.addEventListener("click", () =>
      cy.zoom({ level: cy.zoom() * 1.2, renderedPosition: { x: container.clientWidth / 2, y: container.clientHeight / 2 } }));
    document.getElementById("curr-zoom-out")?.addEventListener("click", () =>
      cy.zoom({ level: cy.zoom() / 1.2, renderedPosition: { x: container.clientWidth / 2, y: container.clientHeight / 2 } }));
    document.getElementById("curr-reset")?.addEventListener("click", () => { exitFocus(); cy.fit(undefined, 60); });
  }

  document.addEventListener("astro:page-load", initCurriculum);
  if (document.readyState !== "loading") initCurriculum();
</script>
