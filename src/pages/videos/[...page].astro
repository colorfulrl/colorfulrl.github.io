---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import VideoCard from "@/components/VideoCard.astro";
import VideoBrowser from "@/components/VideoBrowser.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedVideos, getPlaylists } from "@/utils/videos";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const videos = await getSortedVideos();
  return paginate(videos, {
    pageSize: 12,
    props: { playlists: getPlaylists(videos) },
  });
}) satisfies GetStaticPaths;

const { page, playlists } = Astro.props;
const t = useTranslations();
---

<Layout title={`${t.pages.videosTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.videosTitle} pageDesc={t.pages.videosDesc} i18nTitle="pages.videosTitle" i18nDesc="pages.videosDesc">
    <VideoBrowser playlists={playlists} />
    {
      page.data.length === 0 ? (
        <p class="text-muted-foreground italic" data-i18n="videos.comingSoon">{t.videos.comingSoon}</p>
      ) : (
        <ul class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {page.data.map(video => (
            <VideoCard {...video} />
          ))}
        </ul>
      )
    }
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
