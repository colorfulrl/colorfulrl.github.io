---
import type { CollectionEntry } from "astro:content";
import IconVideo from "@/assets/icons/IconVideo.svg";
import { useTranslations } from "@/i18n";
import { getYoutubeId, playlistSlug } from "@/utils/videos";

type Props = CollectionEntry<"videos">;

const { id, data } = Astro.props;
const {
  title,
  titleEn,
  youtube,
  src,
  thumbnail,
  description,
  descriptionEn,
  date,
  playlists,
} = data;

const t = useTranslations();
const tEn = useTranslations("en");

const youtubeId = getYoutubeId(youtube);
const poster =
  thumbnail ??
  (youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : undefined);

const formattedDate = date
  ? date.toLocaleDateString("vi-VN", { year: "numeric", month: "short" })
  : null;
---

<li
  data-video-id={youtubeId ?? id}
  class="border-border bg-surface group/card flex h-full flex-col overflow-hidden rounded-lg border transition-all duration-300 hover:border-accent/50 hover:shadow-lg">
  <div class="bg-muted relative w-full shrink-0 overflow-hidden" style="aspect-ratio: 16/9;">
    <span
      data-watched-badge
      hidden
      class="absolute top-2 left-2 z-10 rounded bg-black/70 px-2 py-0.5 text-xs font-medium text-white"
      data-i18n="videos.watched"
    >{t.videos.watched}</span>
    {
      youtubeId ? (
        <button
          type="button"
          data-yt-play={youtubeId}
          data-yt-title={title}
          class="group/play absolute inset-0 h-full w-full cursor-pointer"
          aria-label={`${t.videos.play}: ${title}`}
          data-en-aria-label={`${tEn.videos.play}: ${titleEn ?? title}`}
        >
          {poster && (
            <img
              src={poster}
              alt=""
              width="480"
              height="270"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-300 group-hover/card:scale-105"
            />
          )}
          <span class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors group-hover/play:bg-black/35">
            <span class="flex size-14 items-center justify-center rounded-full bg-red-600 text-white shadow-lg transition-transform group-hover/play:scale-110">
              <IconVideo class="size-7 translate-x-0.5 fill-current" />
            </span>
          </span>
        </button>
      ) : src ? (
        <video
          src={src}
          poster={poster}
          controls
          preload="metadata"
          playsinline
          class="h-full w-full bg-black object-contain"
        />
      ) : (
        <div class="text-muted-foreground flex h-full w-full items-center justify-center">
          <IconVideo class="size-10 opacity-40" />
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <h2 class="font-display font-semibold leading-snug tracking-tight sm:text-lg">
      <a href={`/videos/watch/${id}`} class="hover:text-accent transition-colors">
        <span data-en={titleEn || undefined}>{title}</span>
      </a>
    </h2>

    {
      (formattedDate || playlists.length > 0) && (
        <div class="text-muted-foreground flex flex-wrap items-center gap-2 text-xs">
          {formattedDate && <span>{formattedDate}</span>}
          {playlists.map(name => (
            <a
              href={`/videos/playlist/${playlistSlug(name)}`}
              class="bg-accent/10 text-accent hover:bg-accent/20 rounded px-2 py-0.5 font-medium transition-colors"
            >
              {name}
            </a>
          ))}
        </div>
      )
    }

    {
      description && (
        <p data-en={descriptionEn || undefined} class="text-sm leading-relaxed">
          {description}
        </p>
      )
    }

    {
      youtubeId && (
        <div class="mt-auto pt-2">
          <a
            href={`https://www.youtube.com/watch?v=${youtubeId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent inline-block text-sm font-medium decoration-dashed underline-offset-4 hover:underline"
          >
            <span data-i18n="videos.watchOnYoutube">{t.videos.watchOnYoutube}</span> ↗
          </a>
        </div>
      )
    }
  </div>
</li>

<script>
  const WATCHED_KEY = "watchedVideos";

  function readWatched(): string[] {
    try {
      return JSON.parse(localStorage.getItem(WATCHED_KEY) ?? "[]");
    } catch {
      return [];
    }
  }

  function markWatched(id: string) {
    try {
      const list = readWatched();
      if (!list.includes(id)) {
        list.push(id);
        localStorage.setItem(WATCHED_KEY, JSON.stringify(list.slice(-500)));
      }
    } catch {
      /* storage unavailable (private mode) — watched state is a nicety, ignore */
    }
  }

  function showWatchedBadges() {
    const watched = new Set(readWatched());
    document.querySelectorAll<HTMLElement>("[data-video-id]").forEach(card => {
      const isWatched = watched.has(card.dataset.videoId ?? "");
      card.querySelector<HTMLElement>("[data-watched-badge]")?.toggleAttribute("hidden", !isWatched);
    });
  }

  // Lite YouTube embed: only load the iframe once the viewer clicks play.
  function initVideoPlayers() {
    document.querySelectorAll<HTMLButtonElement>("[data-yt-play]").forEach(btn => {
      btn.addEventListener(
        "click",
        () => {
          const id = btn.dataset.ytPlay ?? "";
          markWatched(id);
          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
          iframe.title = btn.dataset.ytTitle ?? "YouTube video";
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;
          iframe.className = "absolute inset-0 h-full w-full border-0";
          btn.replaceWith(iframe);
          showWatchedBadges();
        },
        { once: true }
      );
    });
    showWatchedBadges();
  }

  document.addEventListener("astro:page-load", initVideoPlayers);
</script>
