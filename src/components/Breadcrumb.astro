---
import { stripBase } from "@/utils/withBase";
import { useTranslations } from "@/i18n";

const t = useTranslations();

const currentUrlPath = stripBase(Astro.url.pathname).replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

// Every nav.X key in ui.json is a valid breadcrumb label automatically.
// Adding a page = add its nav.X entry to ui.json; nothing to touch here.
const navLabels = t.nav as unknown as Record<string, string>;

interface BreadcrumbItem {
  text: string;
  navKey?: string;
  pageNum?: number;
}

const breadcrumbsMeta: BreadcrumbItem[] = (() => {
  // /posts/2  → Posts (page 2)
  if (
    breadcrumbList[0] === "posts" &&
    breadcrumbList.length >= 2 &&
    !isNaN(Number(breadcrumbList[1]))
  ) {
    return [{ text: t.nav.posts, navKey: "nav.posts", pageNum: parseInt(breadcrumbList[1], 10) }];
  }
  // /tags/[tag]/2  → Tags > [tag] (page 2)
  if (
    breadcrumbList[0] === "tags" &&
    breadcrumbList.length >= 3 &&
    !isNaN(Number(breadcrumbList[2]))
  ) {
    const pageNum = parseInt(breadcrumbList[2], 10);
    return [
      { text: t.nav.tags, navKey: "nav.tags" },
      { text: decodeSegment(breadcrumbList[1]), pageNum: pageNum > 1 ? pageNum : undefined },
    ];
  }
  // Default: navKey auto-derived from navLabels — no per-segment hardcoding needed
  return breadcrumbList.map(b => ({
    text: navLabels[b] ?? decodeSegment(b),
    navKey: b in navLabels ? `nav.${b}` : undefined,
  }));
})();
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href="/" class="opacity-80">
        <span data-i18n="nav.home">{t.nav.home}</span>
      </a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbsMeta.map((item, index) => {
        const isLast = index + 1 === breadcrumbsMeta.length;

        return isLast ? (
          <li>
            <span
              class:list={["capitalize opacity-75", { lowercase: index > 0 }]}
              aria-current="page"
            >
              {item.navKey ? (
                <span data-i18n={item.navKey}>{item.text}</span>
              ) : (
                item.text
              )}
              {item.pageNum && (
                <>
                  {" "}
                  (<span data-i18n="pagination.page">{t.pagination.page.toLowerCase()}</span> {item.pageNum})
                </>
              )}
            </span>
          </li>
        ) : (
          <li>
            <a
              href={`/${item.text.toLowerCase().replace(/\s+/g, "-")}`}
              class="capitalize opacity-70"
            >
              {item.navKey ? (
                <span data-i18n={item.navKey}>{item.text}</span>
              ) : (
                item.text
              )}
              {item.pageNum && (
                <>
                  {" "}
                  (<span data-i18n="pagination.page">{t.pagination.page.toLowerCase()}</span> {item.pageNum})
                </>
              )}
            </a>
            <span aria-hidden="true" class="opacity-70">
              &raquo;
            </span>
          </li>
        );
      })
    }
  </ul>
</nav>
