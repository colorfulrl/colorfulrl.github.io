---
import { stripBase } from "@/utils/withBase";
import { useTranslations } from "@/i18n";

const t = useTranslations();

const currentUrlPath = stripBase(Astro.url.pathname).replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

const navLabels: Record<string, string> = {
  posts: t.nav.posts,
  tags: t.nav.tags,
  about: t.nav.about,
  archives: t.nav.archives,
  search: t.nav.search,
};

// Metadata for breadcrumbs that need special rendering (with i18n)
interface BreadcrumbItem {
  text: string;
  navKey?: string; // for i18n
  pageNum?: number; // if pagination
}

const breadcrumbsMeta: BreadcrumbItem[] = breadcrumbList.map(b => ({ text: b }));

// if breadcrumb is Home > Posts > [page] <etc>
// replace Posts with metadata for localized rendering
if (breadcrumbsMeta[0]?.text === "posts") {
  const pageNum = breadcrumbList[1] ? parseInt(breadcrumbList[1], 10) : 1;
  breadcrumbsMeta.splice(0, 2, {
    text: t.nav.posts,
    navKey: "nav.posts",
    pageNum,
  });
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// keep tag name as-is, add page metadata if present
if (breadcrumbsMeta[0]?.text === "tags" && breadcrumbsMeta[2]?.text && !isNaN(Number(breadcrumbsMeta[2].text))) {
  const tagName = decodeSegment(breadcrumbsMeta[1]?.text || "");
  const pageNum = parseInt(breadcrumbsMeta[2]?.text || "1", 10);
  breadcrumbsMeta.splice(1, 3, {
    text: tagName,
    pageNum: pageNum > 1 ? pageNum : undefined,
  });
}
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href="/" class="opacity-80">
        <span data-i18n="nav.home">{t.nav.home}</span>
      </a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbsMeta.map((item, index) => {
        const isLast = index + 1 === breadcrumbsMeta.length;

        return isLast ? (
          <li>
            <span
              class:list={["capitalize opacity-75", { lowercase: index > 0 }]}
              aria-current="page"
            >
              {item.navKey ? (
                <span data-i18n={item.navKey}>{item.text}</span>
              ) : (
                item.text
              )}
              {item.pageNum && (
                <>
                  {" "}
                  (<span data-i18n="pagination.page">{t.pagination.page.toLowerCase()}</span> {item.pageNum})
                </>
              )}
            </span>
          </li>
        ) : (
          <li>
            <a
              href={`/${item.text.toLowerCase().replace(/\s+/g, "-")}`}
              class="capitalize opacity-70"
            >
              {item.navKey ? (
                <span data-i18n={item.navKey}>{item.text}</span>
              ) : (
                item.text
              )}
              {item.pageNum && (
                <>
                  {" "}
                  (<span data-i18n="pagination.page">{t.pagination.page.toLowerCase()}</span> {item.pageNum})
                </>
              )}
            </a>
            <span aria-hidden="true" class="opacity-70">
              &raquo;
            </span>
          </li>
        );
      })
    }
  </ul>
</nav>
