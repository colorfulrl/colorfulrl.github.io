---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  category: string;
  categoryName: string;
};

const { category, categoryName } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `categories/${category}/`)}
    transition:name={category}
    class:list={[
      "bg-muted text-foreground inline-block rounded-full px-4 py-1.5 text-sm font-medium",
      "hover:bg-accent hover:text-accent-foreground",
      "focus-visible:bg-accent focus-visible:text-accent-foreground",
    ]}
  >
    {categoryName}
  </a>
</li>
