---
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  wide?: boolean;
  i18nTitle?: string;
  i18nTitleSuffix?: string;
  i18nDesc?: string;
  i18nDescSuffix?: string;
  enTitle?: string;
};

const { pageTitle, pageDesc, class: className, wide, i18nTitle, i18nTitleSuffix, i18nDesc, i18nDescSuffix, enTitle } = Astro.props;

const backUrl = config.features.showBackButton ? Astro.url.pathname : "/";
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={[
    wide
      ? "mx-auto w-full px-4 pb-4 sm:px-6 lg:px-8 max-w-5xl lg:max-w-6xl xl:max-w-7xl"
      : "app-layout pb-4",
    className,
  ]}
>
  <h1 class="text-2xl font-semibold sm:text-3xl" data-en={enTitle || undefined}>
    {i18nTitle
      ? <><span data-i18n={i18nTitle}>{pageTitle}</span>{i18nTitleSuffix ?? ""}</>
      : pageTitle}
  </h1>
  <p class="mt-2 mb-6 italic">
    {i18nDesc
      ? <><span data-i18n={i18nDesc}>{pageDesc}</span>{i18nDescSuffix ?? ""}</>
      : pageDesc}
  </p>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
