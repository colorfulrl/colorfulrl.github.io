---
import type { CollectionEntry } from "astro:content";
import { RESOURCE_TYPES } from "@/data/resourceTypes";
import { useTranslations } from "@/i18n";

type Props = CollectionEntry<"resources">;

const { data } = Astro.props;
const { title, url, type, source, description, descriptionEn, thumbnail, date } = data;

const t = useTranslations();
const tEn = useTranslations("en");

const meta = RESOURCE_TYPES[type] ?? {
  vi: type, en: type,
  badgeBg: "bg-zinc-100 dark:bg-zinc-800",
  badgeText: "text-zinc-700 dark:text-zinc-300",
  iconBg: "", iconColor: "",
};

const label = meta.vi;

const formattedDate = date
  ? date.toLocaleDateString("vi-VN", { year: "numeric", month: "short" })
  : null;
---

<li
  class="border-border bg-surface group/card flex h-full flex-col overflow-hidden rounded-lg border transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-lg"
  data-search={[title, source, description, descriptionEn].filter(Boolean).join(" ").toLowerCase()}
>
  <div class="bg-muted w-full shrink-0 overflow-hidden" style="aspect-ratio: 16/9;">
    {thumbnail && (
      <img
        src={thumbnail}
        alt=""
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover/card:scale-105"
      />
    )}
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex items-start justify-between gap-3">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="group/link"
      >
        <h3 class="font-display text-accent decoration-dashed underline-offset-4 font-semibold leading-snug group-hover/link:underline">
          {title}
          <span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5">↗</span>
        </h3>
      </a>
      <span
        class:list={[
          "mt-0.5 shrink-0 rounded px-2 py-0.5 text-xs font-medium",
          meta.badgeBg,
          meta.badgeText,
        ]}
      >
        <span data-en={meta.en !== meta.vi ? meta.en : undefined}>{label}</span>
      </span>
    </div>

    {(source || formattedDate) && (
      <p class="text-muted-foreground text-xs">
        {source}{source && formattedDate && " · "}{formattedDate}
      </p>
    )}

    {description && (
      <div>
        <p data-res-desc data-en={descriptionEn || undefined} class="line-clamp-3 text-sm leading-relaxed">
          {description}
        </p>
        <button
          data-res-toggle
          data-more-vi={t.ebooks.readMore}
          data-more-en={tEn.ebooks.readMore}
          data-less-vi={t.ebooks.readLess}
          data-less-en={tEn.ebooks.readLess}
          hidden
          class="text-accent mt-1 text-xs hover:underline focus:outline-none"
        >
          {t.ebooks.readMore}
        </button>
      </div>
    )}
  </div>
</li>

<script>
  function resBtnLabel(btn: HTMLButtonElement, type: "more" | "less") {
    const lang = document.documentElement.getAttribute("data-lang") || "vi";
    const key = lang === "en" ? (type + "En") : (type + "Vi");
    return (btn.dataset as Record<string, string>)[key] ?? btn.dataset[type] ?? "";
  }

  function initResourceToggles() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-res-toggle]")
      .forEach(btn => {
        const fresh = btn.cloneNode(true) as HTMLButtonElement;
        btn.replaceWith(fresh);

        const desc = fresh.previousElementSibling as HTMLElement | null;
        if (!desc) return;

        if (desc.scrollHeight <= desc.clientHeight) return;
        fresh.hidden = false;
        fresh.textContent = resBtnLabel(fresh, "more");

        fresh.addEventListener("click", () => {
          const expanding = desc.classList.contains("line-clamp-3");
          desc.classList.toggle("line-clamp-3", !expanding);
          fresh.dataset.expanded = expanding ? "1" : "";
          fresh.textContent = resBtnLabel(fresh, expanding ? "less" : "more");
        });
      });
  }

  const resLangObs = new MutationObserver(() => {
    document.querySelectorAll<HTMLButtonElement>("[data-res-toggle]:not([hidden])").forEach(btn => {
      btn.textContent = resBtnLabel(btn, btn.dataset.expanded === "1" ? "less" : "more");
    });
  });
  resLangObs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-lang"] });

  document.addEventListener("astro:page-load", initResourceToggles);
</script>
