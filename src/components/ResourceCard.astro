---
import type { CollectionEntry } from "astro:content";
import { RESOURCE_TYPES } from "@/data/resourceTypes";
import config from "@/config";
type Props = CollectionEntry<"resources">;

const { data } = Astro.props;
const { title, url, type, source, description, descriptionEn, date } = data;

const locale = Astro.currentLocale ?? config.site.lang;
const localizedDescription = locale === "en" ? (descriptionEn ?? description) : description;

const meta = RESOURCE_TYPES[type] ?? {
  vi: type, en: type,
  badgeBg: "bg-zinc-100 dark:bg-zinc-800",
  badgeText: "text-zinc-700 dark:text-zinc-300",
  iconBg: "", iconColor: "",
};

const label = locale === "en" ? meta.en : meta.vi;

const formattedDate = date
  ? date.toLocaleDateString(locale === "en" ? "en-US" : "vi-VN", {
      year: "numeric",
      month: "short",
    })
  : null;
---

<li class="border-border bg-surface rounded-lg border p-4 transition-colors hover:border-accent/50">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="group block"
  >
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-accent group-hover:underline decoration-dashed underline-offset-4 font-semibold leading-snug">
        {title}
        <span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
      </h3>
      <span
        class:list={[
          "mt-0.5 shrink-0 rounded px-2 py-0.5 text-xs font-medium",
          meta.badgeBg,
          meta.badgeText,
        ]}
      >
        {label}
      </span>
    </div>

    {(source || formattedDate) && (
      <p class="text-muted-foreground mt-1 text-xs">
        {source}{source && formattedDate && " · "}{formattedDate}
      </p>
    )}

    {localizedDescription && (
      <p class="mt-2 line-clamp-2 text-sm leading-relaxed">{localizedDescription}</p>
    )}
  </a>
</li>
