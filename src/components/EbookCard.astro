---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = CollectionEntry<"ebooks">;

const { data } = Astro.props;
const { title, author, description, descriptionEn, cover, link, restricted } =
  data;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const localizedDescription =
  locale === "en" ? descriptionEn ?? description : description;

const mailUrl = config.socials.find(social => social.name === "mail")?.url;
const contactHref = mailUrl
  ? `${mailUrl}?subject=${encodeURIComponent(`${t.ebooks.requestSubject}: ${title}`)}`
  : undefined;
---

<li class="border-border bg-surface flex flex-row overflow-hidden rounded-lg border">
  <div class="bg-muted aspect-[2/3] w-24 shrink-0 overflow-hidden sm:w-32">
    {
      cover ? (
        <Image
          src={cover}
          alt={title}
          width={400}
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="text-muted-foreground flex h-full w-full items-center justify-center p-2 text-center text-xs italic">
          {title}
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h2 class="font-display text-lg font-semibold tracking-tight">{title}</h2>
    {author && <p class="text-muted-foreground text-sm">{t.ebooks.by} {author}</p>}
    {
      localizedDescription && (
        <div>
          <p
            data-ebook-desc
            class="line-clamp-3 text-sm leading-relaxed"
          >
            {localizedDescription}
          </p>
          <button
            data-ebook-toggle
            data-more={t.ebooks.readMore}
            data-less={t.ebooks.readLess}
            hidden
            class="text-accent mt-1 text-xs hover:underline focus:outline-none"
          >
            {t.ebooks.readMore}
          </button>
        </div>
      )
    }
    <div class="mt-auto pt-2">
      {
        restricted ? (
          contactHref ? (
            <a
              href={contactHref}
              class="text-accent inline-block text-sm font-medium decoration-dashed underline-offset-4 hover:underline"
            >
              {t.ebooks.contactToGet} →
            </a>
          ) : (
            <span class="text-muted-foreground text-sm italic">
              {t.ebooks.contactToGet}
            </span>
          )
        ) : link ? (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent inline-block text-sm font-medium decoration-dashed underline-offset-4 hover:underline"
          >
            {t.ebooks.viewLink} →
          </a>
        ) : (
          <span class="text-muted-foreground text-sm italic">
            {t.ebooks.comingSoon}
          </span>
        )
      }
    </div>
    {
      restricted && (
        <p class="text-muted-foreground text-xs italic">
          {t.ebooks.restrictedNote}
        </p>
      )
    }
  </div>
</li>

<script>
  function initEbookToggles() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-ebook-toggle]")
      .forEach(btn => {
        // Remove previous listener by replacing with a fresh clone
        const fresh = btn.cloneNode(true) as HTMLButtonElement;
        btn.replaceWith(fresh);

        const desc = fresh.previousElementSibling as HTMLElement | null;
        if (!desc) return;

        // Only show toggle when text is actually clamped
        if (desc.scrollHeight <= desc.clientHeight) return;
        fresh.hidden = false;

        fresh.addEventListener("click", () => {
          const expanding = desc.classList.contains("line-clamp-3");
          desc.classList.toggle("line-clamp-3", !expanding);
          fresh.textContent = expanding
            ? fresh.dataset.less!
            : fresh.dataset.more!;
        });
      });
  }

  document.addEventListener("astro:page-load", initEbookToggles);
</script>
