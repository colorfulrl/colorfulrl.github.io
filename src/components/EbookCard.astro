---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = CollectionEntry<"ebooks">;

const { data } = Astro.props;
const { title, author, description, descriptionEn, cover, link, restricted } =
  data;

const t = useTranslations();
const tEn = useTranslations("en");

const mailUrl = config.socials.find(social => social.name === "mail")?.url;
const contactHref = mailUrl
  ? `${mailUrl}?subject=${encodeURIComponent(`${t.ebooks.requestSubject}: ${title}`)}`
  : undefined;
---

<li class="border-border bg-surface group flex h-full flex-row overflow-hidden rounded-lg border transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-lg">
  <!-- Cover: portrait ratio, fixed width -->
  <div class="bg-muted w-44 shrink-0 self-stretch overflow-hidden sm:w-56">
    {
      typeof cover === "string" ? (
        <img
          src={cover}
          alt={title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : cover ? (
        <Image
          src={cover}
          alt={title}
          width={400}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="text-muted-foreground flex h-full w-full items-center justify-center p-2 text-center text-xs italic">
          {title}
        </div>
      )
    }
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h2 class="font-display line-clamp-2 text-base font-semibold leading-snug tracking-tight sm:text-lg">{title}</h2>
    {author && <p class="text-muted-foreground text-sm"><span data-i18n="ebooks.by">{t.ebooks.by}</span> {author}</p>}
    {
      description && (
        <div>
          <p
            data-ebook-desc
            data-en={descriptionEn || undefined}
            class="line-clamp-3 text-sm leading-relaxed"
          >
            {description}
          </p>
          <button
            data-ebook-toggle
            data-more-vi={t.ebooks.readMore}
            data-more-en={tEn.ebooks.readMore}
            data-less-vi={t.ebooks.readLess}
            data-less-en={tEn.ebooks.readLess}
            hidden
            class="text-accent mt-1 text-xs hover:underline focus:outline-none"
          >
            {t.ebooks.readMore}
          </button>
        </div>
      )
    }
    <div class="mt-auto pt-2">
      {
        restricted ? (
          contactHref ? (
            <a
              href={contactHref}
              class="text-accent inline-block text-sm font-medium decoration-dashed underline-offset-4 hover:underline"
            >
              <span data-i18n="ebooks.contactToGet">{t.ebooks.contactToGet}</span> →
            </a>
          ) : (
            <span class="text-muted-foreground text-sm italic" data-i18n="ebooks.contactToGet">
              {t.ebooks.contactToGet}
            </span>
          )
        ) : link ? (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent inline-block text-sm font-medium decoration-dashed underline-offset-4 hover:underline"
          >
            <span data-i18n="ebooks.viewLink">{t.ebooks.viewLink}</span> →
          </a>
        ) : (
          <span class="text-muted-foreground text-sm italic" data-i18n="ebooks.comingSoon">
            {t.ebooks.comingSoon}
          </span>
        )
      }
    </div>
    {
      restricted && (
        <p class="text-muted-foreground text-xs italic" data-i18n="ebooks.restrictedNote">
          {t.ebooks.restrictedNote}
        </p>
      )
    }
  </div>
</li>

<script>
  function ebookBtnLabel(btn: HTMLButtonElement, type: "more" | "less") {
    const lang = document.documentElement.getAttribute("data-lang") || "vi";
    const key = lang === "en" ? (type + "En") : (type + "Vi");
    return (btn.dataset as Record<string, string>)[key] ?? btn.dataset[type] ?? "";
  }

  function initEbookToggles() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-ebook-toggle]")
      .forEach(btn => {
        const fresh = btn.cloneNode(true) as HTMLButtonElement;
        btn.replaceWith(fresh);

        const desc = fresh.previousElementSibling as HTMLElement | null;
        if (!desc) return;

        if (desc.scrollHeight <= desc.clientHeight) return;
        fresh.hidden = false;
        fresh.textContent = ebookBtnLabel(fresh, "more");

        fresh.addEventListener("click", () => {
          const expanding = desc.classList.contains("line-clamp-3");
          desc.classList.toggle("line-clamp-3", !expanding);
          fresh.dataset.expanded = expanding ? "1" : "";
          fresh.textContent = ebookBtnLabel(fresh, expanding ? "less" : "more");
        });
      });
  }

  // Re-render visible toggle buttons on lang switch
  const ebookLangObs = new MutationObserver(() => {
    document.querySelectorAll<HTMLButtonElement>("[data-ebook-toggle]:not([hidden])").forEach(btn => {
      btn.textContent = ebookBtnLabel(btn, btn.dataset.expanded === "1" ? "less" : "more");
    });
  });
  ebookLangObs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-lang"] });

  document.addEventListener("astro:page-load", initEbookToggles);
</script>
