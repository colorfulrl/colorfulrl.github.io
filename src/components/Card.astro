---
import type { CollectionEntry } from "astro:content";
import { getPostUrl, getPostSlug } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, titleEn, description, descriptionEn, ...props } = data;

const t = useTranslations();

const postSlug = getPostSlug(id, filePath).replace(/^\//, "");
---

<li class="my-6" data-post-stats-slug={postSlug}>
  <a
    href={getPostUrl(id, filePath)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      data-en={titleEn || undefined}
    >
      {title}
    </Heading>
  </a>
  <div class="flex flex-wrap items-center gap-x-1">
    <Datetime {...props} />
    <span
      data-view-stat
      data-template-vi={t.post.viewCount}
      class="text-muted-foreground text-sm"
    ></span>
    <span data-rating-stat class="text-muted-foreground text-sm"></span>
  </div>
  <p data-en={descriptionEn || undefined}>{description}</p>
</li>
