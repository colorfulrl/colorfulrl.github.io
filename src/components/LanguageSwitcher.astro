---
// Client-side language toggle — no server locale needed.
// Active state is managed by i18n-client.ts based on localStorage.
---

<div class="flex items-center gap-1 text-sm font-medium">
  <button
    data-lang-btn="vi"
    class="px-1.5 py-0.5 rounded transition-colors text-accent font-semibold"
    aria-label="Tiếng Việt"
  >
    VI
  </button>
  <span class="text-border" aria-hidden="true">|</span>
  <button
    data-lang-btn="en"
    class="px-1.5 py-0.5 rounded transition-colors text-muted-foreground hover:text-foreground"
    aria-label="English"
  >
    EN
  </button>
</div>
