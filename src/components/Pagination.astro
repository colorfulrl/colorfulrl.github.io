---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations();

// `paginate()` doesn't expose a "jump to page N" helper, only prev/next/first/last.
// Derive the page-1 base URL, then rebuild `${base}/${n}` for any N — matches the
// `/route`, `/route/2`, `/route/3`... URL scheme Astro generates by default (no
// trailing slash — confirmed via `page.url.next` on page 1, e.g. `/posts/2`).
const rawBase =
  page.currentPage === 1
    ? page.url.current
    : page.url.first ??
      page.url.current.replace(new RegExp(`/${page.currentPage}/?$`), "");
const basePath = rawBase.replace(/\/$/, "");

const pageHref = (n: number) => (n === 1 ? basePath : `${basePath}/${n}`);

// Always show page 1, last page, current page, and its immediate neighbors;
// everything else collapses into a "…" gap.
const pageNumbers = [
  ...new Set(
    [1, page.lastPage, page.currentPage - 1, page.currentPage, page.currentPage + 1].filter(
      n => n >= 1 && n <= page.lastPage
    )
  ),
].sort((a, b) => a - b);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex flex-wrap items-center justify-center gap-2"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={[
          "focus-outline flex size-9 items-center justify-center rounded-md select-none",
          { "opacity-40": !page.url.prev },
        ]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
      </LinkButton>

      {pageNumbers.map((n, i) => (
        <>
          {i > 0 && n - pageNumbers[i - 1] > 1 && (
            <span class="text-muted-foreground px-1 select-none" aria-hidden="true">
              …
            </span>
          )}
          {n === page.currentPage ? (
            <span
              class="bg-accent text-accent-foreground flex size-9 items-center justify-center rounded-md text-sm font-medium select-none"
              aria-current="page"
            >
              {n}
            </span>
          ) : (
            <a
              href={pageHref(n)}
              class="border-border text-foreground hover:bg-accent hover:text-accent-foreground hover:border-accent focus-outline flex size-9 items-center justify-center rounded-md border text-sm font-medium"
            >
              {n}
            </a>
          )}
        </>
      ))}

      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={[
          "focus-outline flex size-9 items-center justify-center rounded-md select-none",
          { "opacity-40": !page.url.next },
        ]}
        aria-label={t.a11y.goToNextPage}
      >
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
